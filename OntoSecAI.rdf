    <rdf:Description>
        <Purpose>Identifies which privacy requirements in the system depend on data security.</Purpose>
        <RuleID>R‑DEP‑006</RuleID>
        <owl1:Name>Privacy depends on Data Security</owl1:Name>
        <Condition:Inference>If a SecurityRequirements has category &quot;Privacy&quot; and depends on a SecurityRequirements with category &quot;DataSecurity&quot;, then dependency is established.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SecurityRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
