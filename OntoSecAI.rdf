    <!-- http://www.semanticweb.org/hp/ontologies/SR-A4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-A4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdversarialRobustness"/>
        <owl1:Description>The system may optionally train with adversarial examples to improve robustness.</owl1:Description>
        <owl1:Name>Adversarial Training</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0041 – Adversarial Training).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-A4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdversarialRobustness"/>
        <owl1:Description>The system may optionally train with adversarial examples to improve robustness.</owl1:Description>
        <owl1:Name>Adversarial Training</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0041 – Adversarial Training).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-A5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-A5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdversarialRobustness"/>
        <owl1:Description>The system shall reconstruct inputs before inference to remove perturbations.</owl1:Description>
        <owl1:Name>Input Reconstruction Defense</owl1:Name>
        <owl1:Source>General best practice for defense.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-A5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdversarialRobustness"/>
        <owl1:Description>The system shall reconstruct inputs before inference to remove perturbations.</owl1:Description>
        <owl1:Name>Input Reconstruction Defense</owl1:Name>
        <owl1:Source>General best practice for defense.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AGT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AGT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAISecurity"/>
        <owl1:Description>The system shall sandbox agent execution to isolate agents from each other and from host resources.</owl1:Description>
        <owl1:Name>Execution Sandbox</owl1:Name>
        <owl1:Source>OWASP Agentic AI Security Guidance.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AGT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAISecurity"/>
        <owl1:Description>The system shall sandbox agent execution to isolate agents from each other and from host resources.</owl1:Description>
        <owl1:Name>Execution Sandbox</owl1:Name>
        <owl1:Source>OWASP Agentic AI Security Guidance.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AGT2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AGT2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAISecurity"/>
        <owl1:Description>The system shall require human approval for high-risk agent actions (e.g., code execution, data deletion).</owl1:Description>
        <owl1:Name>High-risk Action Approval</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM06:2025 – Excessive Agency).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AGT2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAISecurity"/>
        <owl1:Description>The system shall require human approval for high-risk agent actions (e.g., code execution, data deletion).</owl1:Description>
        <owl1:Name>High-risk Action Approval</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM06:2025 – Excessive Agency).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AGT3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AGT3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAISecurity"/>
        <owl1:Description>The system shall limit agent tool access to least-privilege model.</owl1:Description>
        <owl1:Name>Least-privilege Tools</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AC-6 (Least Privilege).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AGT3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAISecurity"/>
        <owl1:Description>The system shall limit agent tool access to least-privilege model.</owl1:Description>
        <owl1:Name>Least-privilege Tools</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AC-6 (Least Privilege).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AGT4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AGT4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAISecurity"/>
        <owl1:Name>Multi-agent Anomaly Detection</owl1:Name>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AGT4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAISecurity"/>
        <owl1:Description>The system shall monitor agent communication for anomalous patterns indicative of multi-agent coordination attacks.</owl1:Description>
        <owl1:Name>Multi-agent Anomaly Detection</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0051 – Agent-Based Execution).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AGT5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AGT5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAISecurity"/>
        <owl1:Description>The system shall block tools that can bypass security controls (e.g., raw shell execution, file system writes without approval).</owl1:Description>
        <owl1:Name>Block Dangerous Tools</owl1:Name>
        <owl1:Source>OWASP Agentic AI Security Guidance.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AGT5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAISecurity"/>
        <owl1:Description>The system shall block tools that can bypass security controls (e.g., raw shell execution, file system writes without approval).</owl1:Description>
        <owl1:Name>Block Dangerous Tools</owl1:Name>
        <owl1:Source>OWASP Agentic AI Security Guidance.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AGT6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AGT6">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAISecurity"/>
        <owl1:Description>The system shall enforce agent session isolation to prevent cross-session data leakage.</owl1:Description>
        <owl1:Name>Session Isolation</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AC-3 (Access Enforcement).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AGT6"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAISecurity"/>
        <owl1:Description>The system shall enforce agent session isolation to prevent cross-session data leakage.</owl1:Description>
        <owl1:Name>Session Isolation</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AC-3 (Access Enforcement).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AGY1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AGY1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExcessiveAgency"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AGY1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExcessiveAgency"/>
        <owl1:Description>The system shall enforce least-privilege tool access – agents only access permitted tools.</owl1:Description>
        <owl1:Name>Least-privilege Tools</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM06:2025 – Excessive Agency).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AGY2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AGY2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExcessiveAgency"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AGY2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExcessiveAgency"/>
        <owl1:Description>The system shall limit tool usage frequency and scope per agent session.</owl1:Description>
        <owl1:Name>Tool Usage Limits</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM06:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AGY3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AGY3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExcessiveAgency"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AGY3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExcessiveAgency"/>
        <owl1:Description>The system shall require approval for sensitive tool invocations (e.g., data deletion, payments).</owl1:Description>
        <owl1:Name>Sensitive Tool Approval</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM06:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AGY4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AGY4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExcessiveAgency"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AGY4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExcessiveAgency"/>
        <owl1:Description>The system shall log all agent tool invocations for audit and monitoring.</owl1:Description>
        <owl1:Name>Tool Invocation Logging</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-2 (Audit Events).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AGY5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AGY5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExcessiveAgency"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AGY5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExcessiveAgency"/>
        <owl1:Description>The system shall automatically revoke agent tool access when anomalous behavior is detected.</owl1:Description>
        <owl1:Name>Anomaly-based Revocation</owl1:Name>
        <owl1:Source>OWASP Agentic AI Security Guidance.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-API1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-API1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#API&amp;EndpointSecurity"/>
        <owl1:Description>The system shall require API keys or OAuth tokens for all inference endpoints.</owl1:Description>
        <owl1:Name>API Authentication</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control IA-2 (Identification and Authentication).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-API1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#API&amp;EndpointSecurity"/>
        <owl1:Description>The system shall require API keys or OAuth tokens for all inference endpoints.</owl1:Description>
        <owl1:Name>API Authentication</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control IA-2 (Identification and Authentication).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-API2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-API2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#API&amp;EndpointSecurity"/>
        <owl1:Description>The system shall enforce input size limits to prevent resource exhaustion (e.g., max tokens, image dimensions).</owl1:Description>
        <owl1:Name>Input Size Limits</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM10:2025 – Unbounded Consumption).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-API2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#API&amp;EndpointSecurity"/>
        <owl1:Description>The system shall enforce input size limits to prevent resource exhaustion (e.g., max tokens, image dimensions).</owl1:Description>
        <owl1:Name>Input Size Limits</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM10:2025 – Unbounded Consumption).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-API3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-API3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#API&amp;EndpointSecurity"/>
        <owl1:Description>The system shall detect repeated query patterns indicative of model extraction (e.g., near-duplicate requests with small variations).</owl1:Description>
        <owl1:Name>Model Extraction Pattern Detection</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0043 – Model Extraction).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-API3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#API&amp;EndpointSecurity"/>
        <owl1:Description>The system shall detect repeated query patterns indicative of model extraction (e.g., near-duplicate requests with small variations).</owl1:Description>
        <owl1:Name>Model Extraction Pattern Detection</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0043 – Model Extraction).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-API4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-API4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#API&amp;EndpointSecurity"/>
        <owl1:Description>The system shall log all API requests for security monitoring, with sensitive fields masked.</owl1:Description>
        <owl1:Name>Request Logging</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-2 (Audit Events).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-API4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#API&amp;EndpointSecurity"/>
        <owl1:Description>The system shall log all API requests for security monitoring, with sensitive fields masked.</owl1:Description>
        <owl1:Name>Request Logging</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-2 (Audit Events).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-API5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-API5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#API&amp;EndpointSecurity"/>
        <owl1:Description>The system shall support request signing to prevent replay attacks.</owl1:Description>
        <owl1:Source>NIST SP 800-53, Control SC-8 (Transmission Confidentiality and Integrity).</owl1:Source>
        <owl1:Source>Request Signing</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-API5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#API&amp;EndpointSecurity"/>
        <owl1:Description>The system shall support request signing to prevent replay attacks.</owl1:Description>
        <owl1:Name>Request Signing</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SC-8 (Transmission Confidentiality and Integrity).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AUD1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AUD1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Audit&amp;Compliance"/>
        <owl1:Description>The system shall log all security-relevant events including access, configuration changes, and model updates.</owl1:Description>
        <owl1:Name>Security Event Logging</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-2 (Audit Events).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AUD1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Audit&amp;Compliance"/>
        <owl1:Description>The system shall log all security-relevant events including access, configuration changes, and model updates.</owl1:Description>
        <owl1:Name>Security Event Logging</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-2 (Audit Events).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AUD2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AUD2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Audit&amp;Compliance"/>
        <owl1:Description>The system shall protect audit logs from tampering and unauthorized modification (tamper-evident).</owl1:Description>
        <owl1:Name>Tamper-evident Logs</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-9 (Protection of Audit Information).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AUD2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Audit&amp;Compliance"/>
        <owl1:Description>The system shall protect audit logs from tampering and unauthorized modification (tamper-evident).</owl1:Description>
        <owl1:Name>Tamper-evident Logs</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-9 (Protection of Audit Information).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AUD3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AUD3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Audit&amp;Compliance"/>
        <owl1:Description>The system shall generate reports for regulatory compliance requirements.</owl1:Description>
        <owl1:Name>Compliance Reporting</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.8 (Documentation).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AUD3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Audit&amp;Compliance"/>
        <owl1:Description>The system shall generate reports for regulatory compliance requirements.</owl1:Description>
        <owl1:Name>Compliance Reporting</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.8 (Documentation).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AUD4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AUD4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Audit&amp;Compliance"/>
        <owl1:Description>The system shall enforce a minimum retention period for audit logs.</owl1:Description>
        <owl1:Name>Log Retention Period</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-11 (Audit Record Retention).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AUD4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Audit&amp;Compliance"/>
        <owl1:Description>The system shall enforce a minimum retention period for audit logs.</owl1:Description>
        <owl1:Name>Log Retention Period</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-11 (Audit Record Retention).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-AUD5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-AUD5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Audit&amp;Compliance"/>
        <owl1:Description>The system shall scan system state against compliance rules (e.g., GDPR, HIPAA, SOC2).</owl1:Description>
        <owl1:Name>Automated Compliance Scanning</owl1:Name>
        <owl1:Source>General best practice for compliance.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-AUD5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Audit&amp;Compliance"/>
        <owl1:Description>The system shall scan system state against compliance rules (e.g., GDPR, HIPAA, SOC2).</owl1:Description>
        <owl1:Name>Automated Compliance Scanning</owl1:Name>
        <owl1:Source>General best practice for compliance.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-BIAS1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-BIAS1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TrainingData&amp;BiasSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-BIAS1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TrainingData&amp;BiasSecurity"/>
        <owl1:Description>The system shall record protected attribute labels for bias assessment where permissible.</owl1:Description>
        <owl1:Name>Protected Attribute Recording</owl1:Name>
        <owl1:Source>Microsoft Responsible AI Standard.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-BIAS2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-BIAS2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TrainingData&amp;BiasSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-BIAS2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TrainingData&amp;BiasSecurity"/>
        <owl1:Description>The system shall compute fairness metrics on model outputs for each protected group.</owl1:Description>
        <owl1:Name>Fairness Metric Calculation</owl1:Name>
        <owl1:Source>Microsoft Responsible AI Standard.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-BIAS3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-BIAS3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TrainingData&amp;BiasSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-BIAS3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TrainingData&amp;BiasSecurity"/>
        <owl1:Description>The system shall flag disparate impact when statistical disparities exceed configurable thresholds.</owl1:Description>
        <owl1:Name>Disparate Impact Flagging</owl1:Name>
        <owl1:Source>NIST AI 100-1, Valid and Reliable (Fairness).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-BIAS4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-BIAS4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TrainingData&amp;BiasSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-BIAS4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TrainingData&amp;BiasSecurity"/>
        <owl1:Description>The system shall document bias mitigation strategies applied and their effectiveness.</owl1:Description>
        <owl1:Name>Mitigation Documentation</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.7 (Data Management and Provenance).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-C1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-C1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AccessControl"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-C1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AccessControl"/>
        <owl1:Description>The system shall require secure authentication for all administrative and sensitive operations.</owl1:Description>
        <owl1:Name>Authentication for Sensitive operations</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control IA-2 (Identification and Authentication).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-C2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-C2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AccessControl"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-C2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AccessControl"/>
        <owl1:Description>The system shall enforce least-privilege access for users and services.</owl1:Description>
        <owl1:Name>Least Privilege</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AC-6 (Least Privilege).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-C3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-C3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AccessControl"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-C3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AccessControl"/>
        <owl1:Description>The system shall authenticate internal service communication.</owl1:Description>
        <owl1:Name>Service-to-service Authentication</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control IA-9 (Service Identification and Authentication).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-C4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-C4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AccessControl"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-C4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AccessControl"/>
        <owl1:Description>The system shall store credentials and keys in secure vault systems, not in code or logs.</owl1:Description>
        <owl1:Name>Secrets Management</owl1:Name>
        <owl1:Source>ISO/IEC 27001, Annex A.10.1 (Cryptographic controls).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-C5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-C5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AccessControl"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-C5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AccessControl"/>
        <owl1:Description>The system shall require multi-factor authentication for privileged roles.</owl1:Description>
        <owl1:Name>MFA Enforcement</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control IA-2(1) (MFA for Privileged Accounts).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-C6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-C6">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AccessControl"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-C6"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AccessControl"/>
        <owl1:Description>The system shall support just-in-time (JIT) access – time-limited access elevation.</owl1:Description>
        <owl1:Name>Just-in-time Access</owl1:Name>
        <owl1:Source>General best practice for access management.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-CI1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-CI1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Container&amp;Infrastructure"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-CI1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Container&amp;Infrastructure"/>
        <owl1:Description>The system shall use hardened container images for all AI workloads (training, inference, data processing).</owl1:Description>
        <owl1:Name>Hardened Container Images</owl1:Name>
        <owl1:Source>OWASP AISVS Category 4.1 (Container Security).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-CI2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-CI2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Container&amp;Infrastructure"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-CI2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Container&amp;Infrastructure"/>
        <owl1:Description>The system shall isolate training and inference environments to prevent cross-contamination.</owl1:Description>
        <owl1:Name>Environment Isolation</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure Deployment Phase.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-CI3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-CI3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Container&amp;Infrastructure"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-CI3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Container&amp;Infrastructure"/>
        <owl1:Description>The system shall restrict model container network access to only required endpoints.</owl1:Description>
        <owl1:Name>Minimal Network Access</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AC-4 (Information Flow Enforcement).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-CI4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-CI4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Container&amp;Infrastructure"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-CI4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Container&amp;Infrastructure"/>
        <owl1:Description>The system shall mount model artifacts as read-only volumes in inference containers to prevent modification.</owl1:Description>
        <owl1:Name>Read-only Model Mounts</owl1:Name>
        <owl1:Source>OWASP AISVS Category 4.2.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-CLOUD1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-CLOUD1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Cloud&amp;InfrastructureSecurity"/>
        <owl1:Description>The system shall isolate tenant models and data in multi-tenant deployments (hardware-level isolation for GPU tenants if required).</owl1:Description>
        <owl1:Name>Multi-tenant Isolation</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AC-3 (Access Enforcement).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-CLOUD1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Cloud&amp;InfrastructureSecurity"/>
        <owl1:Description>The system shall isolate tenant models and data in multi-tenant deployments (hardware-level isolation for GPU tenants if required).</owl1:Description>
        <owl1:Name>Multi-tenant Isolation</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AC-3 (Access Enforcement).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-CLOUD2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-CLOUD2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Cloud&amp;InfrastructureSecurity"/>
        <owl1:Description>The system shall support model inference in confidential computing enclaves (e.g., AMD SEV, Intel SGX).</owl1:Description>
        <owl1:Name>Confidential Computing</owl1:Name>
        <owl1:Source>Google Secure AI Framework.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-CLOUD2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Cloud&amp;InfrastructureSecurity"/>
        <owl1:Description>The system shall support model inference in confidential computing enclaves (e.g., AMD SEV, Intel SGX).</owl1:Description>
        <owl1:Name>Confidential Computing</owl1:Name>
        <owl1:Source>Google Secure AI Framework.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-CLOUD3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-CLOUD3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Cloud&amp;InfrastructureSecurity"/>
        <owl1:Description>The system shall encrypt model weights at rest and in use (e.g., via trusted execution environment).</owl1:Description>
        <owl1:Name>Weight Encryption at Rest and In Use</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SC-28 (Protection of Information at Rest).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-CLOUD3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Cloud&amp;InfrastructureSecurity"/>
        <owl1:Description>The system shall encrypt model weights at rest and in use (e.g., via trusted execution environment).</owl1:Description>
        <owl1:Name>Weight Encryption at Rest &amp; in Use</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SC-28 (Protection of Information at Rest).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-CLOUD4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-CLOUD4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Cloud&amp;InfrastructureSecurity"/>
        <owl1:Description>The system shall automatically rotate inference endpoint URLs to reduce blast radius after compromise.</owl1:Description>
        <owl1:Name>Endpoint Rotation</owl1:Name>
        <owl1:Source>General best practice for resilience.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-CLOUD4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Cloud&amp;InfrastructureSecurity"/>
        <owl1:Description>The system shall automatically rotate inference endpoint URLs to reduce blast radius after compromise.</owl1:Description>
        <owl1:Name>Endpoint Rotation</owl1:Name>
        <owl1:Source>General best practice for resilience.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-CN1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-CN1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/TC260GenerativeAISecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-CN1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/TC260GenerativeAISecurity"/>
        <owl1:Description>The system shall ensure all generated content does not violate laws and regulations, and shall implement mechanisms to detect and block prohibited content.</owl1:Description>
        <owl1:Name>Generative AI Content Security</owl1:Name>
        <owl1:Source>China TC260 — &quot;Basic Requirements for Security of Generative Artificial Intelligence Services of Cybersecurity Technology&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-CN2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-CN2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/TC260GenerativeAISecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-CN2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/TC260GenerativeAISecurity"/>
        <owl1:Description>The system shall verify the legality and all training data sources, including obtaining proper authorization for copyrighted materials used in training.</owl1:Description>
        <owl1:Name>Training Data Source Legality</owl1:Name>
        <owl1:Source>China TC260 — &quot;Data Security Specifications for Generative Artificial Intelligence Pre-training and Optimization Training&quot; (GB/T 45652-2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-CN3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-CN3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/TC260GenerativeAISecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-CN3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/TC260GenerativeAISecurity"/>
        <owl1:Description>The system shall implement security functions, security management, and role‑based security responsibilities for AI computing platforms, applicable to design, construction, application, and operation and maintenance.</owl1:Description>
        <owl1:Name>AI Computing Platform Security</owl1:Name>
        <owl1:Source>China TC260 — &quot;Cybersecurity technology — Security framework for artificial intelligence computing platform&quot; (GB/T 45958-2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-CN4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-CN4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/TC260GenerativeAISecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-CN4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/TC260GenerativeAISecurity"/>
        <owl1:Description>The system shall clearly label AI‑generated content with appropriate provenance information to help users identify synthetic or AI‑generated outputs.</owl1:Description>
        <owl1:Name>Content Provenance Labeling</owl1:Name>
        <owl1:Source>China TC260 — Generative AI Service Security Requirements</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-CN5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-CN5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/TC260GenerativeAISecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-CN5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/TC260GenerativeAISecurity"/>
        <owl1:Description>The system shall provide accessible mechanisms for users to report issues, submit complaints, and provide feedback on AI‑generated content, with documented response procedures.</owl1:Description>
        <owl1:Name>User Complaint and Feedback Mechanism</owl1:Name>
        <owl1:Source>China TC260 — Generative AI Service Security Requirements — &quot;complaint mechanisms&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-INCID1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-INCID1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentDetection&amp;Containment"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-INCID1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentDetection&amp;Containment"/>
        <owl1:Description>The system shall detect and alert on prompt injection attacks in real time.</owl1:Description>
        <owl1:Name>Real-time Injection Alert</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM01:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-INCID2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-INCID2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentDetection&amp;Containment"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-INCID2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentDetection&amp;Containment"/>
        <owl1:Description>The system shall quarantine suspicious models when poisoning or tampering is detected.</owl1:Description>
        <owl1:Name>Suspicious Model Quarantine</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure Maintenance Phase.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-INCID3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-INCID3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentDetection&amp;Containment"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-INCID3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentDetection&amp;Containment"/>
        <owl1:Description>The system shall automatically revoke compromised API keys upon suspicious activity detection.</owl1:Description>
        <owl1:Name>API Key Revocation</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control IR-4 (Incident Handling).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-INCID4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-INCID4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentDetection&amp;Containment"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-INCID4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentDetection&amp;Containment"/>
        <owl1:Description>The system shall implement circuit breakers to prevent cascading failures during attacks.</owl1:Description>
        <owl1:Name>Circuit Breakers</owl1:Name>
        <owl1:Source>General best practice for resilience.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-INF1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-INF1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/InferencePrivacy"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-INF1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/InferencePrivacy"/>
        <owl1:Description>The system shall limit the number of queries per user per model to reduce membership inference risk.</owl1:Description>
        <owl1:Name>Query Limiting</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0042 – Membership Inference).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-INF2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-INF2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/InferencePrivacy"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-INF2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/InferencePrivacy"/>
        <owl1:Description>The system shall add calibrated noise to outputs (for numeric predictions) to prevent attribute inference.</owl1:Description>
        <owl1:Name>Output Noise Calibration</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0044 – Attribute Inference).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-INF3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-INF3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/InferencePrivacy"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-INF3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/InferencePrivacy"/>
        <owl1:Description>The system shall detect out-of-distribution inputs to avoid overconfident leakage of training data.</owl1:Description>
        <owl1:Name>Out-of-distribution Distribution</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0042 – Membership Inference).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-INF4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-INF4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/InferencePrivacy"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-INF4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/InferencePrivacy"/>
        <owl1:Description>The system shall sanitize model outputs by removing verbatim memorized training sequences (for LLMs).</owl1:Description>
        <owl1:Name>Memorization Sanitization</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM02:2025 – Sensitive Information Disclosure).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-IOH1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-IOH1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ImproperOutputHandling"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-IOH1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ImproperOutputHandling"/>
        <owl1:Description>The system shall validate and sanitize all outputs before passing to downstream components.</owl1:Description>
        <owl1:Name>Pre-downstream Sanitization</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM05:2025 – Improper Output Handling).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-IOH2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-IOH2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ImproperOutputHandling"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-IOH2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ImproperOutputHandling"/>
        <owl1:Description>The system shall escape or neutralize code execution risks in outputs.</owl1:Description>
        <owl1:Name>Code Execution Neutralization</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM05:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-IOH3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-IOH3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ImproperOutputHandling"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-IOH3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ImproperOutputHandling"/>
        <owl1:Description>The system shall enforce output origin checks – verify outputs came from the intended model.</owl1:Description>
        <owl1:Name>Output Origin Enforcement</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SI-7 (Software, Firmware, and Information Integrity).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-IOH4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-IOH4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ImproperOutputHandling"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-IOH4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ImproperOutputHandling"/>
        <owl1:Description>The system shall reject output generation when safety checks fail.</owl1:Description>
        <owl1:Name>Safety Check Rejection</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure Maintenance Phase.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-IR1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-IR1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponse&amp;Forensics"/>
        <owl1:Description>The system shall support model quarantine – block inference requests to a suspect model without deleting it.</owl1:Description>
        <owl1:Name>Model Quarantine</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure Maintenance Phase.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-IR1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponse&amp;Forensics"/>
        <owl1:Description>The system shall support model quarantine – block inference requests to a suspect model without deleting it.</owl1:Description>
        <owl1:Name>Model Quarantine</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure Maintenance Phase.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-IR2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-IR2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponse&amp;Forensics"/>
        <owl1:Description>The system shall provide forensic reconstruction of a model’s training data lineage for post-incident analysis.</owl1:Description>
        <owl1:Name>Forensic Lineage Reconstruction</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.7 (Data Management and Provenance).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-IR2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponse&amp;Forensics"/>
        <owl1:Description>The system shall provide forensic reconstruction of a model’s training data lineage for post-incident analysis.</owl1:Description>
        <owl1:Name>Forensic Lineage Reconstruction</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.7 (Data Management and Provenance).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-IR3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-IR3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponse&amp;Forensics"/>
        <owl1:Description>The system shall compare model versions to identify exactly when abnormal behavior (e.g., backdoor) was introduced.</owl1:Description>
        <owl1:Name>Version Comparison for Root Cause</owl1:Name>
        <owl1:Source>General best practice for forensics.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-IR3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponse&amp;Forensics"/>
        <owl1:Description>The system shall compare model versions to identify exactly when abnormal behavior (e.g., backdoor) was introduced.</owl1:Description>
        <owl1:Name>Version Comparison for Root Cause</owl1:Name>
        <owl1:Source>General best practice for forensics.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-IR4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-IR4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponse&amp;Forensics"/>
        <owl1:Description>The system shall generate security incident timelines automatically from logs, model update history, and access records.</owl1:Description>
        <owl1:Name>Automated Incident Timeline</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-6 (Audit Review, Analysis, and Reporting).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-IR4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponse&amp;Forensics"/>
        <owl1:Description>The system shall generate security incident timelines automatically from logs, model update history, and access records.</owl1:Description>
        <owl1:Name>Automated Incident Timeline</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-6 (Audit Review, Analysis, and Reporting).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ISO1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ISO1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ISO1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
        <owl1:Description>The system shall maintain a comprehensive inventory of all AI systems, including purpose, data sources, model types, risk classification, and responsible parties.</owl1:Description>
        <owl1:Name>AI System Inventory</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause 6.2.1 — AI System Inventory</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ISO2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ISO2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ISO2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
        <owl1:Description>The system shall implement a structured development lifecycle including design, training, validation, deployment, monitoring, and decommissioning stages for all AI systems.</owl1:Description>
        <owl1:Name>AI System Lifecycle Management</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause 8.9 — AI System Development Lifecycle</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ISO3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ISO3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ISO3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
        <owl1:Description>The system shall implement controls for training data quality, provenance, representativeness, and protection throughout the AI lifecycle.</owl1:Description>
        <owl1:Name>Training Data Governance</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause 8.3 — Training Data Management</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ISO4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ISO4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ISO4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
        <owl1:Description>The system shall maintain version control for AI models, training data, configurations, and documentation to enable rollback and change tracking.</owl1:Description>
        <owl1:Name>AI System Versioning</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause 8.10 — AI System Versioning</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ISO5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ISO5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ISO5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
        <owl1:Description>The system shall classify training, testing, and operational data based on sensitivity, regulatory requirements, and potential bias implications.</owl1:Description>
        <owl1:Name>Data Classification for AI</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause 5.12 — Data Classification for AI</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ISO6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ISO6">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ISO6"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
        <owl1:Description>The system shall operate within an organizational AI governance policy covering acceptable use, risk tolerance, ethical principles, and accountability structures for AI systems.</owl1:Description>
        <owl1:Name>AI Policy Establishment</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause 5.2 — AI Policy</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ISO7 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ISO7">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ISO7"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ISO-AIControls"/>
        <owl1:Description>The system shall support safe decommissioning of AI systems including data archival, model preservation, and transition planning.</owl1:Description>
        <owl1:Name>Safe AI system Retirement</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause 8.32 — AI System Retirement</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-LOG1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-LOG1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Logging"/>
        <owl1:Description>The system shall log all AI lifecycle events including data ingestion, training runs, model versions, and inference.</owl1:Description>
        <owl1:Name>Lifecycle Event Logging</owl1:Name>
        <owl1:Source>EU AI Act, Article 12 (Record-keeping).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-LOG1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Logging"/>
        <owl1:Description>The system shall log all AI lifecycle events including data ingestion, training runs, model versions, and inference.</owl1:Description>
        <owl1:Name>Lifecycle Event Logging</owl1:Name>
        <owl1:Source>EU AI Act, Article 12 (Record-keeping).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-LOG2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-LOG2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Logging"/>
        <owl1:Description>The system shall support reconstruction of decisions for audit purposes.</owl1:Description>
        <owl1:Name>Decision Reconstruction</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.8 (Documentation).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-LOG2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Logging"/>
        <owl1:Description>The system shall support reconstruction of decisions for audit purposes.</owl1:Description>
        <owl1:Name>Decision Reconstruction</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.8 (Documentation).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-LOG3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-LOG3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Logging"/>
        <owl1:Description>The system shall protect audit logs from tampering using write-once, append-only storage.</owl1:Description>
        <owl1:Name>Tamper-proof Audit Storage</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-9 (Protection of Audit Information).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-LOG3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Logging"/>
        <owl1:Description>The system shall protect audit logs from tampering using write-once, append-only storage.</owl1:Description>
        <owl1:Name>Tamper-proof Audit Storage</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-9 (Protection of Audit Information).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-LOG4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-LOG4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Logging"/>
        <owl1:Description>The system shall include request ID, user ID, model version, input, output, confidence, and timestamp in inference logs.</owl1:Description>
        <owl1:Name>Rich Inference Log Fields</owl1:Name>
        <owl1:Source>EU AI Act, Article 12.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-LOG4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Logging"/>
        <owl1:Description>The system shall include request ID, user ID, model version, input, output, confidence, and timestamp in inference logs.</owl1:Description>
        <owl1:Name>Rich Inference Log Fields</owl1:Name>
        <owl1:Source>EU AI Act, Article 12.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-LOG5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-LOG5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Logging"/>
        <owl1:Description>The system shall ensure logs are forensically sound and admissible in legal proceedings.</owl1:Description>
        <owl1:Name>Forensic Soundness</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-6 (Audit Review, Analysis, and Reporting).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-LOG5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Logging"/>
        <owl1:Description>The system shall ensure logs are forensically sound and admissible in legal proceedings.</owl1:Description>
        <owl1:Name>Forensic Soundness</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-6 (Audit Review, Analysis, and Reporting).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ML1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ML1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/MLSecOpsSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ML1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/MLSecOpsSecurity"/>
        <owl1:Description>The system shall embed security controls at every stage of the machine learning lifecycle, from data collection to model deployment, ensuring model integrity throughout CI/CD pipelines.</owl1:Description>
        <owl1:Name>Model Integrity in CI/CD Pipelines</owl1:Name>
        <owl1:Source>Cloudsmith 2026 Guide — &quot;MLSecOps for model integrity&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ML2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ML2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/MLSecOpsSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ML2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/MLSecOpsSecurity"/>
        <owl1:Description>The system shall conduct AI‑specific risk assessments that evaluate threats unique to ML systems, including data poisoning, model extraction, and adversarial inputs.</owl1:Description>
        <owl1:Name>AI‑aware Risk Assessments</owl1:Name>
        <owl1:Source>MLSecOps Framework — &quot;AI‑aware risk assessments&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ML3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ML3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/MLSecOpsSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ML3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/MLSecOpsSecurity"/>
        <owl1:Description>The system shall manage the complete lifecycle of AI artifacts (model weights, training data, embeddings) from creation through deployment to retirement, with cryptographic provenance tracking.</owl1:Description>
        <owl1:Name>Binary Lifecycle Management for AI</owl1:Name>
        <owl1:Source>MLSecOps 2026 Guide — &quot;binary lifecycle management for artifact provenance&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ML4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ML4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/MLSecOpsSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ML4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/MLSecOpsSecurity"/>
        <owl1:Description>The system shall integrate risk assessment, threat modeling, and security hardening into machine learning development from day one, not as an afterthought.</owl1:Description>
        <owl1:Name>Security by design for ML Development</owl1:Name>
        <owl1:Source>MLSecOps Framework — &quot;Security by Design — integrating risk assessment, threat modeling, and hardening into ML development from day one&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ML5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ML5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/MLSecOpsSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ML5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/MLSecOpsSecurity"/>
        <owl1:Description>The system shall continuously monitor AI systems for signs of adversarial manipulation, data misuse, and model degradation, with automated alerting mechanisms.</owl1:Description>
        <owl1:Name>Monitoring for Adversarial Manipulation</owl1:Name>
        <owl1:Source>MLSecOps — &quot;governance, risk, and resilience controls that protect against adversarial manipulation and data misuse&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-N1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-N1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ControlOverlays"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-N1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ControlOverlays"/>
        <owl1:Description>The system shall implement adapted NIST SP 800-53 controls specifically tailored to address AI‑specific vulnerabilities, using the COSAIS framework to identify and apply relevant controls.</owl1:Description>
        <owl1:Name>Control Overlay for AI Vulnerabilities</owl1:Name>
        <owl1:Source>NIST — &quot;Control Overlays for Securing AI Systems (COSAIS) — adapts existing federal cybersecurity standards (SP 800-53) to address unique vulnerabilities in AI&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-N2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-N2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ControlOverlays"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-N2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ControlOverlays"/>
        <owl1:Description>The system shall review the entire NIST 800-53 control catalog to identify and highlight key controls for adoption or adaptation to secure AI systems, ensuring no critical controls are missed for AI contexts.</owl1:Description>
        <owl1:Name>AI Threat Adaptation of Existing Controls</owl1:Name>
        <owl1:Source>NIST — &quot;reviewing the entire catalog to identify and highlight key controls for adoption or adaptation to secure AI systems&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-O1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-O1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/OperationalSecurity"/>
        <owl1:Description>The system shall enforce secure configuration baselines for deployment environments.</owl1:Description>
        <owl1:Name>Secure configuration baselines</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control CM-6 (Configuration Settings).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-O1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/OperationalSecurity"/>
        <owl1:Description>The system shall enforce secure configuration baselines for deployment environments.</owl1:Description>
        <owl1:Name>Secure Configuration Baselines</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control CM-6 (Configuration Settings).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-O2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-O2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/OperationalSecurity"/>
        <owl1:Description>The system shall support continuous vulnerability scanning of dependencies and infrastructure.</owl1:Description>
        <owl1:Name>Vulnerability Scanning</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control RA-5 (Vulnerability Scanning).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-O2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/OperationalSecurity"/>
        <owl1:Description>The system shall support continuous vulnerability scanning of dependencies and infrastructure.</owl1:Description>
        <owl1:Name>Vulnerability Scanning</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control RA-5 (Vulnerability Scanning).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-O3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-O3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/OperationalSecurity"/>
        <owl1:Description>The system shall support detection, alerting, and containment of security incidents.</owl1:Description>
        <owl1:Name>Incident Detection &amp; Containment</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control IR-4 (Incident Handling).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-O3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/OperationalSecurity"/>
        <owl1:Description>The system shall support detection, alerting, and containment of security incidents.</owl1:Description>
        <owl1:Name>Incident Detection &amp; Containment</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control IR-4 (Incident Handling).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-O4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-O4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/OperationalSecurity"/>
        <owl1:Description>The system shall implement rate limits to prevent abuse and denial-of-service attacks.</owl1:Description>
        <owl1:Name>Rate Limiting</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SC-5 (Denial of Service Protection).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-O4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/OperationalSecurity"/>
        <owl1:Description>The system shall implement rate limits to prevent abuse and denial-of-service attacks.</owl1:Description>
        <owl1:Name>Rate Limiting</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SC-5 (Denial of Service Protection).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-O5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-O5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/OperationalSecurity"/>
        <owl1:Description>The system shall remain secure under infrastructure failures (chaos engineering readiness).</owl1:Description>
        <owl1:Name>Chaos Engineering Readiness</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control CP-2 (Contingency Plan).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-O5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/OperationalSecurity"/>
        <owl1:Description>The system shall remain secure under infrastructure failures (chaos engineering readiness).</owl1:Description>
        <owl1:Name>Chaos Engineering Readiness</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control CP-2 (Contingency Plan).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-O6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-O6">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/OperationalSecurity"/>
        <owl1:Description>The system shall scan models and dependencies for backdoors.</owl1:Description>
        <owl1:Name>Backdoor Scanning</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0050 – Backdoor).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-O6"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/OperationalSecurity"/>
        <owl1:Description>The system shall scan models and dependencies for backdoors.</owl1:Description>
        <owl1:Name>Backdoor Scanning</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0050 – Backdoor).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-P1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-P1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall comply with applicable privacy regulations (e.g., GDPR principles).</owl1:Description>
        <owl1:Name>Regulatory Compliance</owl1:Name>
        <owl1:Name>Regulatory compliance</owl1:Name>
        <owl1:Source>GDPR, Article 5 (Principles relating to processing of personal data).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-P1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall comply with applicable privacy regulations (e.g., GDPR principles).</owl1:Description>
        <owl1:Name>Regulatory Compliance</owl1:Name>
        <owl1:Source>GDPR, Article 5 (Principles relating to processing of personal data).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-P2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-P2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall anonymize or pseudonymize sensitive data where applicable.</owl1:Description>
        <owl1:Name>Anonymization / Pseudonymization</owl1:Name>
        <owl1:Source>GDPR, Article 4(5) (Pseudonymisation).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-P2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall anonymize or pseudonymize sensitive data where applicable.</owl1:Description>
        <owl1:Name>Anonymization / Pseudonymization</owl1:Name>
        <owl1:Source>GDPR, Article 4(5) (Pseudonymisation).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-P3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-P3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall support deletion of user data upon request where legally required.</owl1:Description>
        <owl1:Name>Right to Deletion</owl1:Name>
        <owl1:Source>GDPR, Article 17 (Right to erasure / &apos;right to be forgotten&apos;).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-P3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall support deletion of user data upon request where legally required.</owl1:Description>
        <owl1:Name>Right to Deletion</owl1:Name>
        <owl1:Source>GDPR, Article 17 (Right to erasure / &apos;right to be forgotten&apos;).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-P4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-P4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall enforce defined retention periods for all personal data.</owl1:Description>
        <owl1:Name>Retention Limits</owl1:Name>
        <owl1:Source>GDPR, Article 5(1)(e) (Storage limitation).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-P4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall enforce defined retention periods for all personal data.</owl1:Description>
        <owl1:Name>Retention Limits</owl1:Name>
        <owl1:Source>GDPR, Article 5(1)(e) (Storage limitation).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-P5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-P5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall support differential privacy in training or inference queries.</owl1:Description>
        <owl1:Name>Differential Privacy Support</owl1:Name>
        <owl1:Source>ENISA FAICP.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-P5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall support differential privacy in training or inference queries.</owl1:Description>
        <owl1:Name>Differential Privacy Support</owl1:Name>
        <owl1:Source>ENISA FAICP.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-P6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-P6">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall prevent leakage of training data through model outputs (membership inference resistance).</owl1:Description>
        <owl1:Name>Membership Inference Resistance</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0042 – Membership Inference).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-P6"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall prevent leakage of training data through model outputs (membership inference resistance).</owl1:Description>
        <owl1:Name>Membership Inference Resistance</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0042 – Membership Inference).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-P7 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-P7">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall record and enforce user consent for data use.</owl1:Description>
        <owl1:Name>Consent Management</owl1:Name>
        <owl1:Source>GDPR, Article 7 (Conditions for consent).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-P7"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Privacy"/>
        <owl1:Description>The system shall record and enforce user consent for data use.</owl1:Description>
        <owl1:Name>Consent Management</owl1:Name>
        <owl1:Source>GDPR, Article 7 (Conditions for consent).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-PI1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-PI1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/PromptInjectionDefence"/>
        <owl1:Description>The system shall detect and block direct prompt injection attacks across all input channels.</owl1:Description>
        <owl1:Name>Direct Injection Blocking</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM01:2025 – Prompt Injection).</owl1:Source>
        <rdfs:comment>Direct Injection Blocking</rdfs:comment>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-PI1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/PromptInjectionDefence"/>
        <owl1:Description>The system shall detect and block direct prompt injection attacks across all input channels.</owl1:Description>
        <owl1:Name>Direct Injection Blocking</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM01:2025 – Prompt Injection).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-PI2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-PI2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/PromptInjectionDefence"/>
        <owl1:Description>The system shall detect and block indirect prompt injection delivered via RAG sources, emails, documents, or plugins.</owl1:Description>
        <owl1:Name>Indirect Injection Blocking</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM01:2025 – Indirect Prompt Injection).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-PI2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/PromptInjectionDefence"/>
        <owl1:Description>The system shall detect and block indirect prompt injection delivered via RAG sources, emails, documents, or plugins.</owl1:Description>
        <owl1:Name>Indirect Injection Blocking</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM01:2025 – Indirect Prompt Injection).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-PI3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-PI3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/PromptInjectionDefence"/>
        <owl1:Description>The system shall segment untrusted content (user input) from trusted content (system prompt) using structural isolation.</owl1:Description>
        <owl1:Name>Trust Boundary Isolation</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM07:2025 – System Prompt Leakage).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-PI3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/PromptInjectionDefence"/>
        <owl1:Description>The system shall segment untrusted content (user input) from trusted content (system prompt) using structural isolation.</owl1:Description>
        <owl1:Name>Trust Boundary Isolation</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM07:2025 – System Prompt Leakage).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-PI4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-PI4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/PromptInjectionDefence"/>
        <owl1:Description>The system shall apply semantic input filtering to identify adversarial prompt structures.</owl1:Description>
        <owl1:Name>Semantic Input Filtering</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM01:2025).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-PI4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/PromptInjectionDefence"/>
        <owl1:Description>The system shall apply semantic input filtering to identify adversarial prompt structures.</owl1:Description>
        <owl1:Name>Semantic Input Filtering</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM01:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-PI5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-PI5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/PromptInjectionDefence"/>
        <owl1:Description>The system shall log all prompt injection attempts for security monitoring and threat hunting.</owl1:Description>
        <owl1:Name>Injection Attempt Logging</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM01:2025).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-PI5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/PromptInjectionDefence"/>
        <owl1:Description>The system shall log all prompt injection attempts for security monitoring and threat hunting.</owl1:Description>
        <owl1:Name>Injection Attempt Logging</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM01:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-RAG1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-RAG1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#RAGPipelineSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-RAG1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#RAGPipelineSecurity"/>
        <owl1:Description>The system shall validate and sanitize retrieved content before passing to the model.</owl1:Description>
        <owl1:Name>Retrieved Content Sanitization</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM01:2025 – Indirect Prompt Injection).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-RAG2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-RAG2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#RAGPipelineSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-RAG2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#RAGPipelineSecurity"/>
        <owl1:Description>The system shall maintain access control on document retrieval – users can only retrieve data they are authorized to see.</owl1:Description>
        <owl1:Name>Document Access Control</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AC-3 (Access Enforcement).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-RAG3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-RAG3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#RAGPipelineSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-RAG3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#RAGPipelineSecurity"/>
        <owl1:Description>The system shall audit retrieval-access logs to detect unauthorized data access via RAG.</owl1:Description>
        <owl1:Name>Retrieval Audit</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AU-2 (Audit Events).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-RAG4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-RAG4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#RAGPipelineSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-RAG4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#RAGPipelineSecurity"/>
        <owl1:Description>The system shall detect and block retrieval of poisoned documents in vector databases.</owl1:Description>
        <owl1:Name>Poisoned Document Blocking</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM08:2025 – Vector and Embedding Weaknesses).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-SC1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-SC1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SupplyChainSecurity"/>
        <owl1:Description>The system shall validate model provenance – verify that a model came from a trusted source (e.g., signed by internal CI).</owl1:Description>
        <owl1:Name>Model Provenance Validation</owl1:Name>
        <owl1:Source>NIST SP 800-218A, PS.3 (Protect) practice.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-SC1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SupplyChainSecurity"/>
        <owl1:Description>The system shall validate model provenance – verify that a model came from a trusted source (e.g., signed by internal CI).</owl1:Description>
        <owl1:Name>Model Provenance Validation</owl1:Name>
        <owl1:Source>NIST SP 800-218A, PS.3 (Protect) practice.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-SC2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-SC2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SupplyChainSecurity"/>
        <owl1:Description>The system shall scan model files for known vulnerabilities (e.g., pickle deserialization exploits, unsafe dependencies).</owl1:Description>
        <owl1:Name>Vulnerability Scanning of Models</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM03:2025 – Supply Chain Vulnerabilities).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-SC2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SupplyChainSecurity"/>
        <owl1:Description>The system shall scan model files for known vulnerabilities (e.g., pickle deserialization exploits, unsafe dependencies).</owl1:Description>
        <owl1:Name>Vulnerability Scanning of Models</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM03:2025 – Supply Chain Vulnerabilities).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-SC3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-SC3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SupplyChainSecurity"/>
        <owl1:Description>The system shall block models with untrusted base images or containers.</owl1:Description>
        <owl1:Name>Block Untrusted Base Images</owl1:Name>
        <owl1:Source>OWASP AISVS Category 4.1 (Container Security).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-SC3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SupplyChainSecurity"/>
        <owl1:Description>The system shall block models with untrusted base images or containers.</owl1:Description>
        <owl1:Name>Block Untrusted Base Images</owl1:Name>
        <owl1:Source>OWASP AISVS Category 4.1 (Container Security).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-SC4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-SC4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SupplyChainSecurity"/>
        <owl1:Description>The system shall automatically rebuild model artifacts when base libraries have known CVEs.</owl1:Description>
        <owl1:Name>Auto-rebuild on CVE</owl1:Name>
        <owl1:Source>NIST SP 800-218A, PO.1 (Prepare) practice.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-SC4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SupplyChainSecurity"/>
        <owl1:Description>The system shall automatically rebuild model artifacts when base libraries have known CVEs.</owl1:Description>
        <owl1:Name>Auto-rebuild on CVE</owl1:Name>
        <owl1:Source>NIST SP 800-218A, PO.1 (Prepare) practice.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-SID1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-SID1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SensitiveInformationDisclosure"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-SID1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SensitiveInformationDisclosure"/>
        <owl1:Description>The system shall classify and label sensitive data (PII, credentials, intellectual property) in training data.</owl1:Description>
        <owl1:Name>Data Classification</owl1:Name>
        <owl1:Source>GDPR, Article 4(1) (Personal Data).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-SID2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-SID2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SensitiveInformationDisclosure"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-SID2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SensitiveInformationDisclosure"/>
        <owl1:Description>The system shall redact or mask sensitive information in model outputs.</owl1:Description>
        <owl1:Name>Output Redaction</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM02:2025 – Sensitive Information Disclosure)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-SID3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-SID3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SensitiveInformationDisclosure"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-SID3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SensitiveInformationDisclosure"/>
        <owl1:Description>The system shall detect model memorization of training data and prevent verbatim disclosure.</owl1:Description>
        <owl1:Name>Memorization Prevention</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0042 – Membership Inference).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-SID4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-SID4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SensitiveInformationDisclosure"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-SID4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SensitiveInformationDisclosure"/>
        <owl1:Description>The system shall limit output verbosity when responding to sensitive context queries.</owl1:Description>
        <owl1:Name>Verbosity Control</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM02:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-SID5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-SID5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SensitiveInformationDisclosure"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-SID5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SensitiveInformationDisclosure"/>
        <owl1:Description>The system shall audit outputs for sensitive information disclosure on a continuous basis.</owl1:Description>
        <owl1:Name>Continuous Output Auditing</owl1:Name>
        <owl1:Source>Google Secure AI Framework.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-TA1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-TA1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Testing&amp;Assurance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-TA1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Testing&amp;Assurance"/>
        <owl1:Description>The system shall undergo testing by accredited third‑party AI testing firms to verify security weaknesses through methods including red‑teaming and jailbreaking, ensuring independent validation of system security.</owl1:Description>
        <owl1:Name>Third‑party AI Testing Accreditation</owl1:Name>
        <owl1:Source>Singapore AI Verify Foundation — &quot;AI Tester Accreditation Programme&quot; (Q3 2026)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-TA2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-TA2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Testing&amp;Assurance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-TA2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Testing&amp;Assurance"/>
        <owl1:Description>The system shall be assessable against all 11 internationally recognized AI governance principles including transparency, explainability, reproducibility, safety, security, robustness, fairness, and data governance.</owl1:Description>
        <owl1:Name>11‑dimension Governance Testing</owl1:Name>
        <owl1:Source>AI Verify Testing Framework — &quot;translates high-level principles into testable requirements across 11 domains&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-TA3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-TA3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Testing&amp;Assurance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-TA3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Testing&amp;Assurance"/>
        <owl1:Description>The system shall support model‑level security testing that validates resilience against adversarial attacks, prompt injection, and model extraction attempts, using standardized test suites.</owl1:Description>
        <owl1:Name>Model‑level Security Testing</owl1:Name>
        <owl1:Source>AI Verify Framework — testing across transparency, security, robustness</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-TP1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-TP1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRisk"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-TP1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRisk"/>
        <owl1:Description>The system shall vet all third-party models against a security checklist before import.</owl1:Description>
        <owl1:Name>Pre-import Security Checklist</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM03:2025 – Supply Chain Vulnerabilities).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-TP2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-TP2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRisk"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-TP2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRisk"/>
        <owl1:Description>The system shall scan model cards and metadata for known malicious patterns (e.g., hidden triggers).</owl1:Description>
        <owl1:Name>Malicious Pattern Scanning</owl1:Name>
        <owl1:Source>MITRE ATLAS Supply Chain Technique.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-TP3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-TP3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRisk"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-TP3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRisk"/>
        <owl1:Description>The system shall sandbox execution of any third-party model (e.g., isolate via container or WebAssembly).</owl1:Description>
        <owl1:Name>Sandboxed Execution</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure Deployment Phase.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-TP4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-TP4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRisk"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-TP4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRisk"/>
        <owl1:Description>The system shall record dependency licenses and flag banned or high-risk licenses.</owl1:Description>
        <owl1:Name>License Compliance</owl1:Name>
        <owl1:Source>NIST SP 800-218A, PO.1 (Prepare).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-UCP1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-UCP1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#UnboundedConsumption"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-UCP1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#UnboundedConsumption"/>
        <owl1:Description>The system shall enforce per-request resource limits (tokens, time, iterations).</owl1:Description>
        <owl1:Name>Per-request Resource Limits</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM10:2025 – Unbounded Consumption).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-UCP2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-UCP2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#UnboundedConsumption"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-UCP2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#UnboundedConsumption"/>
        <owl1:Description>The system shall rate limit inference requests per user, IP, and API key.</owl1:Description>
        <owl1:Name>Rate Limiting</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM10:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-UCP3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-UCP3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#UnboundedConsumption"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-UCP3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#UnboundedConsumption"/>
        <owl1:Description>The system shall detect resource exhaustion attacks and trigger circuit breakers.</owl1:Description>
        <owl1:Name>Resource Exhaustion Circuit Breaker</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM10:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-UCP4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-UCP4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#UnboundedConsumption"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-UCP4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#UnboundedConsumption"/>
        <owl1:Description>The system shall apply exponential backoff or queueing under high load to preserve availability.</owl1:Description>
        <owl1:Name>Backoff &amp; Queueing</owl1:Name>
        <owl1:Source>General best practice for resilience.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-UCP5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-UCP5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#UnboundedConsumption"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-UCP5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#UnboundedConsumption"/>
        <owl1:Description>The system shall monitor and alert on abnormal consumption patterns indicative of DoS attempts.</owl1:Description>
        <owl1:Name>Consumption Anomaly Alerting</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM10:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-VEC1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-VEC1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Vector&amp;EmbeddingSecurity"/>
        <owl1:Description>The system shall verify embedding integrity using checksums or signatures on vector updates.</owl1:Description>
        <owl1:Name>Embedding Integrity</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM08:2025 – Vector and Embedding Weaknesses).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-VEC1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Vector&amp;EmbeddingSecurity"/>
        <owl1:Description>The system shall validate vector embeddings for integrity before retrieval operations.</owl1:Description>
        <owl1:Name>Embedding Integrity Validation</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM08:2025 – Vector and Embedding Weaknesses).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-VEC2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-VEC2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Vector&amp;EmbeddingSecurity"/>
        <owl1:Description>The system shall detect embedding poisoning via out-of-distribution vectors.</owl1:Description>
        <owl1:Name>Poisoned Embedding Detection</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM08:2025).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-VEC2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Vector&amp;EmbeddingSecurity"/>
        <owl1:Description>The system shall detect and reject poisoned embeddings in vector databases.</owl1:Description>
        <owl1:Name>Poisoned Embedding Rejection</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM08:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-VEC3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-VEC3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Vector&amp;EmbeddingSecurity"/>
        <owl1:Description>The system shall encrypt vector embeddings at rest and in transit.</owl1:Description>
        <owl1:Name>Encryption of Embeddings</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SC-28 (Protection of Information at Rest).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-VEC3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Vector&amp;EmbeddingSecurity"/>
        <owl1:Description>The system shall maintain access controls on vector database collections and embeddings.</owl1:Description>
        <owl1:Name>Access Control on Vector DB</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AC-3 (Access Enforcement).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-VEC4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-VEC4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Vector&amp;EmbeddingSecurity"/>
        <owl1:Name>The system shall authenticate vector database access and enforce data isolation per tenant.</owl1:Name>
        <owl1:Name>Vector DB Authentication</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AC-3 (Access Enforcement).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-VEC4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Vector&amp;EmbeddingSecurity"/>
        <owl1:Description>The system shall log all vector retrieval operations including query embedding, retrieved chunks, and relevance scores.</owl1:Description>
        <owl1:Name>Retrieval Audit Logging</owl1:Name>
        <owl1:Source>General best practice for audit.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-VEC5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-VEC5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Vector&amp;EmbeddingSecurity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-VEC5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Vector&amp;EmbeddingSecurity"/>
        <owl1:Description>The system shall validate vector embeddings for integrity before retrieval operations.</owl1:Description>
        <owl1:Name>Embedding Integrity Validation</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM08:2025 – Vector and Embedding Weaknesses).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ZT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ZT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ZeroTrust"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ZT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ZeroTrust"/>
        <owl1:Description>The system shall apply continuous verification of identity and authorization for every access request to AI models, data pipelines, and inference endpoints, regardless of network location.</owl1:Description>
        <owl1:Name>Continuous Verification for AI Workloads</owl1:Name>
        <owl1:Source>NIST SP 800-207 (Zero Trust Architecture) adapted for AI environments; Securing AI Using Zero Trust Principles</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ZT2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ZT2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ZeroTrust"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ZT2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ZeroTrust"/>
        <owl1:Description>The system shall enforce least‑privilege access principles for all AI components, ensuring users and services have only the minimum permissions necessary to perform their functions.</owl1:Description>
        <owl1:Name>Least‑privilege for Model Access</owl1:Name>
        <owl1:Source>Securing AI Using Zero Trust Principles — &quot;Security by Design for AI&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ZT3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ZT3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ZeroTrust"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ZT3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ZeroTrust"/>
        <owl1:Description>The system shall isolate training, inference, and data preparation environments using network micro‑segmentation to prevent lateral movement in case of compromise.</owl1:Description>
        <owl1:Name>Micro‑segmentation of AI Workloads</owl1:Name>
        <owl1:Source>Zero Trust for AI Systems guidance — identity enforcement, segmentation, and telemetry</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR-ZT4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR-ZT4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ZeroTrust"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR-ZT4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ZeroTrust"/>
        <owl1:Description>The system shall assume no implicit trust for any AI component, requiring explicit verification for every interaction between data sources, model registries, training pipelines, and inference endpoints.</owl1:Description>
        <owl1:Name>Never Trust, Always Verify for AI Pipelines</owl1:Name>
        <owl1:Source>Zero Trust architecture principles (NIST 800-207) applied to AI development workflows</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR2-SECOM1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR2-SECOM1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SecureCommunication"/>
        <owl1:Description>The system shall authenticate and encrypt all communications between AI services (e.g., API gateway, model server, vector DB).</owl1:Description>
        <owl1:Name>Encryption &amp; Authentication for Services</owl1:Name>
        <owl1:Source>Google Secure AI Framework.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR2-SECOM1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SecureCommunication"/>
        <owl1:Description>The system shall authenticate and encrypt all communications between AI services (e.g., API gateway, model server, vector DB).</owl1:Description>
        <owl1:Name>Encryption &amp; Authentication for Services</owl1:Name>
        <owl1:Source>Google Secure AI Framework.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR2-SECOM2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR2-SECOM2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SecureCommunication"/>
        <owl1:Description>The system shall enforce mutual TLS (mTLS)  for service-to-service authentication.</owl1:Description>
        <owl1:Name>Mutual TLS (mTLS) Enforcement</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SC-8 (Transmission Confidentiality and Integrity).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR2-SECOM2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SecureCommunication"/>
        <owl1:Description>The system shall enforce mTLS for service-to-service authentication.</owl1:Description>
        <owl1:Name>Mutual TLS (mTLS) Enforcement</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SC-8 (Transmission Confidentiality and Integrity).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR2-SECOM3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR2-SECOM3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SecureCommunication"/>
        <owl1:Description>The system shall rotate service credentials automatically and frequently.</owl1:Description>
        <owl1:Name>Automatic Credential Rotation</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control IA-5 (Authenticator Management).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR2-SECOM3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SecureCommunication"/>
        <owl1:Description>The system shall rotate service credentials automatically and frequently.</owl1:Description>
        <owl1:Name>Automatic Credential Rotation</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control IA-5 (Authenticator Management).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR2-SECOM4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR2-SECOM4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SecureCommunication"/>
