        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataManagementRequirements"/>
        <owl1:Description>The system shall validate input data against schema rules where applicable.</owl1:Description>
        <owl1:Name>Schema Validation</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SI-10 (Information Input Validation).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D1.3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D1.3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataManagementRequirements"/>
        <owl1:Description>The system shall detect and handle corrupted or incomplete data inputs.</owl1:Description>
        <owl1:Name>Corrupt Data Handling</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.6 (Data Quality).</owl1:Source>
    </owl:NamedIndividual>
