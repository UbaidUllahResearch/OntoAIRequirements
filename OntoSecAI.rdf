    <rdf:Description>
        <Purpose>Identifies the system&apos;s monitoring and observability requirements by checking if they are defined by an Operator.</Purpose>
        <Purpose>Operator Stakeholder Classification</Purpose>
        <RuleID>R‑MAP‑STK‑008</RuleID>
        <Condition:Inference>If a Stakeholder has role &quot;Operator&quot; and defines a Requirement with category MonitoringRequirements or ObservabilityRequirements, then the requirement is classified as a FunctionalRequirement</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
