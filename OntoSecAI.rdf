    <rdf:Description>
        <Purpose>Identifies the system&apos;s governance and compliance requirements by checking if they are defined by a Compliance Officer.</Purpose>
        <RuleID>R‑MAP‑STK‑004</RuleID>
        <owl1:Name>Compliance Officer Classification</owl1:Name>
        <Condition:Inference>If a Stakeholder has role &quot;ComplianceOfficer&quot; and defines a Requirement with category Governance or RegulatoryCompliance, then the requirement is classified as a NonFunctionalRequirement</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
