        <owl1:Source>NIST SP 800-53, Control SI-10 (Information Input Validation).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-A2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdversarialRobustness"/>
        <owl1:Description>The system shall validate and sanitize inputs to prevent manipulation attacks.</owl1:Description>
        <owl1:Name>Input Sanitization</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SI-10 (Information Input Validation).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-A3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-A3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdversarialRobustness"/>
        <owl1:Description>The system shall maintain acceptable performance under perturbed or noisy inputs.</owl1:Description>
        <owl1:Name>Robust inference</owl1:Name>
        <owl1:Source>NIST AI 100-1, Secure and Resilient characteristic.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-A3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdversarialRobustness"/>
        <owl1:Description>The system shall maintain acceptable performance under perturbed or noisy inputs.</owl1:Description>
        <owl1:Name>Robust Inference</owl1:Name>
        <owl1:Source>NIST AI 100-1, Secure and Resilient characteristic.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataSecurity"/>
        <owl1:Description>The system shall encrypt all stored data, including training datasets and model artifacts, using industry-standard algorithms.</owl1:Description>
        <owl1:Name>Encryption at Rest</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SC-28 (Protection of Information at Rest).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataSecurity"/>
        <owl1:Description>The system shall encrypt all stored data, including training datasets and model artifacts, using industry-standard algorithms.</owl1:Description>
        <owl1:Name>Encryption at Rest</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SC-28 (Protection of Information at Rest).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataSecurity"/>
        <owl1:Description>The system shall use secure transport protocols (e.g., TLS 1.2+) for all data exchanges.</owl1:Description>
        <owl1:Name>Encryption in Transit</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SC-8 (Transmission Confidentiality and Integrity).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataSecurity"/>
        <owl1:Description>The system shall use secure transport protocols (e.g., TLS 1.2+) for all data exchanges.</owl1:Description>
        <owl1:Name>Encryption in Transit</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SC-8 (Transmission Confidentiality and Integrity).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataSecurity"/>
        <owl1:Description>The system shall restrict access to data using role-based or attribute-based access control.</owl1:Description>
        <owl1:Name>Access control (RBAC/ABAC)</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AC-3 (Access Enforcement).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataSecurity"/>
        <owl1:Description>The system shall restrict access to data using role-based or attribute-based access control.</owl1:Description>
        <owl1:Name>Access control (RBAC/ABAC)</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control AC-3 (Access Enforcement).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataSecurity"/>
        <owl1:Description>The system shall collect and process only data strictly required for functionality.</owl1:Description>
        <owl1:Name>Data Minimization</owl1:Name>
        <owl1:Source>GDPR, Article 5(1)(c) (Data Minimisation).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataSecurity"/>
        <owl1:Description>The system shall collect and process only data strictly required for functionality.</owl1:Description>
        <owl1:Name>Data Minimization</owl1:Name>
        <owl1:Source>GDPR, Article 5(1)(c) (Data Minimisation).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataSecurity"/>
        <owl1:Description>The system shall maintain encrypted, geographically redundant backups with defined RPO/RTO.</owl1:Description>
        <owl1:Name>Encrypted Backups</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control CP-9 (Information System Backup).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataSecurity"/>
        <owl1:Description>The system shall maintain encrypted, geographically redundant backups with defined RPO/RTO.</owl1:Description>
        <owl1:Name>Encrypted Backups</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control CP-9 (Information System Backup).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D6">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataSecurity"/>
        <owl1:Description>The system shall automatically mask sensitive data in log outputs.</owl1:Description>
        <owl1:Name>Log Masking</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SI-11 (Error Handling).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-D6"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataSecurity"/>
        <owl1:Description>The system shall automatically mask sensitive data in log outputs.</owl1:Description>
        <owl1:Name>Log Masking</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SI-11 (Error Handling).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelSecurity"/>
        <owl1:Description>The system shall verify integrity of model files using cryptographic checksums or signatures.</owl1:Description>
        <owl1:Name>Cryptographic Integrity Verification</owl1:Name>
        <owl1:Source>OWASP AISVS Category 3.1.1.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelSecurity"/>
        <owl1:Description>The system shall verify integrity of model files using cryptographic checksums or signatures.</owl1:Description>
        <owl1:Name>Cryptographic Integrity Verification</owl1:Name>
        <owl1:Source>OWASP AISVS Category 3.1.1.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelSecurity"/>
        <owl1:Description>The system shall detect unauthorized modifications to model parameters or weights.</owl1:Description>
        <owl1:Name>Tampering Detection</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SI-7 (Software, Firmware, and Information Integrity).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelSecurity"/>
        <owl1:Description>The system shall detect unauthorized modifications to model parameters or weights.</owl1:Description>
        <owl1:Name>Tampering Detection</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SI-7 (Software, Firmware, and Information Integrity).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelSecurity"/>
        <owl1:Description>The system shall implement controls to reduce risk of model stealing through repeated querying.</owl1:Description>
        <owl1:Name>Model Extraction Resistance</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0043 – Model Extraction).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelSecurity"/>
        <owl1:Description>The system shall implement controls to reduce risk of model stealing through repeated querying.</owl1:Description>
        <owl1:Name>Model Extraction Resistance</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0043 – Model Extraction).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelSecurity"/>
        <owl1:Description>The system shall secure training pipelines against unauthorized access or injection.</owl1:Description>
        <owl1:Name>Training Pipeline Security</owl1:Name>
        <owl1:Source>NIST SP 800-218A (Secure Development).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelSecurity"/>
        <owl1:Description>The system shall secure training pipelines against unauthorized access or injection.</owl1:Description>
        <owl1:Name>Training Pipeline Security</owl1:Name>
        <owl1:Source>NIST SP 800-218A (Secure Development).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelSecurity"/>
        <owl1:Description>The system shall embed watermarks to detect unauthorized model distribution.</owl1:Description>
        <owl1:Name>Watermarking</owl1:Name>
        <owl1:Source>General best practice for IP protection.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelSecurity"/>
        <owl1:Description>The system shall embed watermarks to detect unauthorized model distribution.</owl1:Description>
        <owl1:Name>Watermarking</owl1:Name>
        <owl1:Source>General best practice for IP protection.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M6">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelSecurity"/>
        <owl1:Description>The system shall maintain a secure model registry with signed artifacts, access controls, and an audit trail.</owl1:Description>
        <owl1:Name>Secure Model Registry</owl1:Name>
        <owl1:Source>OWASP AISVS Category 3.1.1.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-M6"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelSecurity"/>
        <owl1:Description>The system shall maintain a secure model registry with signed artifacts, access controls, and an audit trail.</owl1:Description>
        <owl1:Name>Secure Model Registry</owl1:Name>
        <owl1:Source>OWASP AISVS Category 3.1.1.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/AITesters&amp;Auditors -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/AITesters&amp;Auditors">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/AITesters&amp;Auditors"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
        <Interactions>All other stakeholders, providing objective assessments of the system&apos;s trustworthiness and identifying risks.</Interactions>
        <Responsibilities>Independently test, evaluate, verify, and validate (TEVV) the AI system&apos;s performance, security, and fairness to detect and remediate problems.</Responsibilities>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/CI/CD -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/CI/CD">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Software&amp;ToolingResources"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hp/ontologies/CivilSociety&amp;ImpactedCommunities -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/CivilSociety&amp;ImpactedCommunities">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/CivilSociety&amp;ImpactedCommunities"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
        <Interactions>All actors via consultations, providing context on potential and actual societal impacts.</Interactions>
        <Responsibilities>Represent the public interest, advocate for human rights, and provide diverse perspectives to ensure the AI system is fair, equitable, and beneficial to society.</Responsibilities>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/Compliance&amp;LegalTeams -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/Compliance&amp;LegalTeams">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/Compliance&amp;LegalTeams"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
        <Interactions>Leadership, developers, deployers, and auditors to establish and enforce governance frameworks.</Interactions>
        <Responsibilities>Interpret regulations (e.g., EU AI Act, GDPR), develop internal policies, conduct impact assessments, and ensure the system meets legal, privacy, and ethical standards.</Responsibilities>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑ACC1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑ACC1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Accessibility"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑ACC1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Accessibility"/>
        <owl1:Description>The system shall comply with accessibility requirements for high-risk AI systems in accordance with Directive (EU) 2016/2102 (Web Accessibility Directive) and Directive (EU) 2019/882 (European Accessibility Act).</owl1:Description>
        <owl1:Name>Accessibility for High-risk AI</owl1:Name>
        <owl1:Source>EU AI Act Article 16(l)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑ACC2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑ACC2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Accessibility"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑ACC2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Accessibility"/>
        <owl1:Description>The system shall be designed for people with the widest range of physical, sensory, and cognitive abilities, including those who are temporarily or situationally disabled, and the elderly.</owl1:Description>
        <owl1:Name>Accessible Software Design</owl1:Name>
        <owl1:Source>ISO 9241-171:2025 — &quot;Software accessibility&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑ACC3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑ACC3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Accessibility"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑ACC3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Accessibility"/>
        <owl1:Description>The system shall be equitable, usable, and beneficial for people with disabilities, ensuring that AI systems are easy for people with disabilities to use.</owl1:Description>
        <owl1:Name>Equitable AI for Persons with Disabilities</owl1:Name>
        <owl1:Source>CAN-ASC-6.2 — &quot;Accessibility requirements for AI systems&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑AIoT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑AIoT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AgenticAIOfThingsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑AIoT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AgenticAIOfThingsRequirements"/>
        <owl1:Description>The system shall implement a functional framework for Agentic Artificial Intelligence of Things (AIoT), integrating autonomous AI agent capabilities with IoT device ecosystems.</owl1:Description>
        <owl1:Name>Agentic AI of Things Framework</owl1:Name>
        <owl1:Source>ITU-T Y.Agentic-AIoT — Functional requirements for Agentic Artificial Intelligence of Things</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑AIoT2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑AIoT2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AgenticAIOfThingsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑AIoT2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AgenticAIOfThingsRequirements"/>
        <owl1:Description>The system shall support an on‑device framework for robot services that integrates AI with IoT capabilities to enable autonomous task execution in physical environments.</owl1:Description>
        <owl1:Name>On‑device Robot Service Framework</owl1:Name>
        <owl1:Source>ITU-T Y.4615 (ex Y.AIoT-RSreq) — Artificial Intelligence of Things — On‑device framework for robot services</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑AIoT3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑AIoT3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AgenticAIOfThingsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑AIoT3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AgenticAIOfThingsRequirements"/>
        <owl1:Description>The system shall align with the reference model and requirements for Artificial Intelligence of Things, including interactions between AI components, IoT devices, and edge computing resources.</owl1:Description>
        <owl1:Name>AIoT Reference Model</owl1:Name>
        <owl1:Source>ITU-T Y.4618 (ex Y.AIoT-FRA) — Artificial Intelligence of Things — Reference model and requirements</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑DATA1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑DATA1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/TrainingDataQualityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑DATA1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/TrainingDataQualityRequirements"/>
        <owl1:Description>The system shall measure how representative the model dataset is of the true population relevant to the purpose of the AI system, documenting coverage gaps and mitigation strategies.</owl1:Description>
        <owl1:Name>Dataset Representativeness Measurement</owl1:Name>
        <owl1:Source>Australian Government — “Technical standard for government’s use of AI: Criterion 67”</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑DATA2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑DATA2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/TrainingDataQualityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑DATA2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/TrainingDataQualityRequirements"/>
        <owl1:Description>The system shall verify that training datasets meet minimum size and quality thresholds for each class or category (e.g., minimum of 20 distinct, high-quality images per object class) based on the complexity of the ML task and risk classification.</owl1:Description>
        <owl1:Name>Minimum Dataset Sufficiency Verification</owl1:Name>
        <owl1:Source>Data in Brief — “minimum of 20 distinct, high-quality images for each object/class” (June 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑DATA3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑DATA3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/TrainingDataQualityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑DATA3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/TrainingDataQualityRequirements"/>
        <owl1:Description>The system shall detect and report missing values, outliers, and data gaps that could significantly impact model training and performance, with defined thresholds for acceptance.</owl1:Description>
        <owl1:Name>Data Completeness Validation</owl1:Name>
        <owl1:Source>NIH — Data completeness and missing data impact assessment</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑ETH1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑ETH1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/EthicalDesignRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑ETH1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/EthicalDesignRequirements"/>
        <owl1:Description>The system shall embed human values (e.g., privacy, accountability, fairness, transparency) into technical architecture decisions, algorithm design choices, and user interface development.</owl1:Description>
        <owl1:Name>Human Values Integration</owl1:Name>
        <owl1:Source>IEEE 7000‑2025 — &quot;Standard for Embedding Human Values and Ethical Considerations in Technology Design&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑ETH2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑ETH2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/EthicalDesignRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑ETH2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/EthicalDesignRequirements"/>
        <owl1:Description>The system shall support structured value elicitation processes during design, enabling traceability from stakeholder values to system requirements and design decisions.</owl1:Description>
        <owl1:Name>Value Elicitation and Traceability</owl1:Name>
        <owl1:Source>IEEE 7000‑2025 — &quot;Guidance on value elicitation and traceability for AI systems&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑FS1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑FS1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/FunctionalSafetyRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑FS1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/FunctionalSafetyRequirements"/>
        <owl1:Description>The system shall manage safety risks associated with AI decisions that can impact physical processes, equipment, or human safety, including collision avoidance, emergency stops, or safe‑state transitions.</owl1:Description>
        <owl1:Name>Functional Safety and AI Integration</owl1:Name>
        <owl1:Source>ISO/IEC CD TS 22440‑1:2026 Artificial intelligence — Functional safety and AI systems — Part 1: Requirements</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑FS2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑FS2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/FunctionalSafetyRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑FS2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/FunctionalSafetyRequirements"/>
        <owl1:Description>The system shall monitor its own operational safety status and trigger a degraded or safe state when AI confidence falls below a defined threshold or when input data is out of distribution.</owl1:Description>
        <owl1:Name>Safety‑monitoring Integration</owl1:Name>
        <owl1:Source>ISO/IEC CD TS 22440‑1:2026 (functional safety)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑HW1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑HW1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/HardwareLevelGovernanceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑HW1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/HardwareLevelGovernanceRequirements"/>
        <owl1:Description>The system shall support hardware‑level integrity verification of the compute environment used for training or inference, including attestation of the AI‑capable processor before model execution.</owl1:Description>
        <owl1:Name>AI Compute Integrity Verification</owl1:Name>
        <owl1:Source>arXiv — &quot;Hardware-Level Governance of AI Compute&quot; (April 2026) – 20 hardware‑level governance mechanisms</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑HW2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑HW2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/HardwareLevelGovernanceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑HW2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/HardwareLevelGovernanceRequirements"/>
        <owl1:Description>The system shall track provenance of AI‑capable processors and accelerator chips used in the AI system, including the ability to verify that no tampering occurred in the semiconductor supply chain.</owl1:Description>
        <owl1:Name>AI Supply Chain Provenance for Compute</owl1:Name>
        <owl1:Source>arXiv — &quot;Hardware-Level Governance of AI Compute&quot; – supply chain trust and semiconductor provenance</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑IA1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑IA1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ImpactAssessmentRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑IA1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ImpactAssessmentRequirements"/>
        <owl1:Description>The system shall support AI system impact assessments that evaluate the effects of AI systems on individuals and societies across different stages of the AI system lifecycle.</owl1:Description>
        <owl1:Name>AI System Impact Assessment</owl1:Name>
        <owl1:Source>ISO/IEC 42005:2025 — &quot;AI System Impact Assessment&quot; (released May 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑IA2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑IA2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ImpactAssessmentRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑IA2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ImpactAssessmentRequirements"/>
        <owl1:Description>The system shall enable organizations to identify and manage the potential benefits and harms of AI system use and deployment across their lifecycle.</owl1:Description>
        <owl1:Name>Impact Assessment Integration</owl1:Name>
        <owl1:Source>ISO/IEC 42005:2025 — &quot;comprehensive guidance on AI system impact assessments&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑INT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑INT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ModelInterpretabilityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑INT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ModelInterpretabilityRequirements"/>
        <owl1:Description>The system shall implement documented goals and approaches for model explainability and interpretability, establishing clear objectives for what explanations must achieve for different stakeholders.</owl1:Description>
        <owl1:Name>Goals and Approaches for Explainability</owl1:Name>
        <owl1:Source>ISO/IEC JTC1/SC42 — &quot;Goals and approaches for the explainability and interpretability of machine learning models&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑LEG1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑LEG1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/LegalRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑LEG1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/LegalRequirements"/>
        <owl1:Description>The system shall support disclosure of evidence related to AI system behaviour, model outputs, and decision paths to enable plaintiffs to establish causal links between system defects and damages, addressing the evidentiary burden under the AI Liability Directive (AILD).</owl1:Description>
        <owl1:Name>Evidence Disclosure for AI‑related Harm</owl1:Name>
        <owl1:Source>EU AI Act &amp; AILD Proposal — “disclosure of evidence and burden of proof rules”</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑LEG2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑LEG2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/LegalRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑LEG2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/LegalRequirements"/>
        <owl1:Description>The system shall detect and log potential discriminatory outputs or biased decisions that could cause immaterial harms (e.g., discrimination, reputational damage) to enable legal recourse when such harms occur without an individual’s awareness.</owl1:Description>
        <owl1:Name>Bias‑related Harm Detection</owl1:Name>
        <owl1:Source>YJOLT — AI liability framework analysis (2025–2026): “immaterial harms such as discrimination will often happen without an individual’s awareness”</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑LIA1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑LIA1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/LiabilityManagementRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑LIA1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/LiabilityManagementRequirements"/>
        <owl1:Description>The system shall include liability‑driven safety features that enable safe stopping or aborting of AI decisions when fatal errors, fraud, or critical failures are detected.</owl1:Description>
        <owl1:Name>Liability‑driven Safety Features</owl1:Name>
        <owl1:Source>Safety‑critical AI framework — safety features including stopping or aborting AI decisions when fatal fraud or error is detected in a safe approach</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑REP1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑REP1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ReproducibilityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑REP1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ReproducibilityRequirements"/>
        <owl1:Description>The system shall implement reproducibility protocols that capture and document all elements required to reproduce any model output or decision, including code, hyperparameters, environment configuration, random seeds, data versions, and inference parameters.</owl1:Description>
        <owl1:Name>Full Reproducibility Protocol</owl1:Name>
        <owl1:Source>arXiv — “Reproducibility: The New Frontier in AI Governance”</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑REP2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑REP2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ReproducibilityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑REP2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ReproducibilityRequirements"/>
        <owl1:Description>The system shall support the logging of negative results and statistical leverage metrics to enable proper evaluation of model validity and reduce publication or reporting bias.</owl1:Description>
        <owl1:Name>Negative Result and Statistical leverage Logging</owl1:Name>
        <owl1:Source>AI Research Reproducibility Guidelines — preregistration, statistical leverage, and negative result reporting</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑REP3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑REP3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ReproducibilityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑REP3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ReproducibilityRequirements"/>
        <owl1:Description>The system shall provide documentation of reasoning steps and decision paths sufficient for independent validation of LLM reasoning claims, including the ability to verify the novelty of generated outputs.</owl1:Description>
        <owl1:Name>Scientific Transparency for Reasoning Validation</owl1:Name>
        <owl1:Source>arXiv — “The Refutability Gap: Challenges in Validating Reasoning by Large Language Models”</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑RISK1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑RISK1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/RiskManagement"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑RISK1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/RiskManagement"/>
        <owl1:Description>The system shall implement risk management requirements covering both risks to health and safety and risks to fundamental rights which can arise from AI systems, with impact for individuals, organisations, market, and society.</owl1:Description>
        <owl1:Name>Comprehensive AI Risk Management</owl1:Name>
        <owl1:Source>prEN 18228:2025 — &quot;Risk management for AI systems&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑RISK2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑RISK2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/RiskManagement"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑RISK2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/RiskManagement"/>
        <owl1:Description>The system shall provide clear and actionable guidance on how risk can be addressed and mitigated throughout the entire lifecycle of the AI system.</owl1:Description>
        <owl1:Name>Lifecycle Risk Mitigation</owl1:Name>
        <owl1:Source>prEN 18228:2025</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑SBOM1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑SBOM1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SoftwareBillOfMaterialsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑SBOM1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SoftwareBillOfMaterialsRequirements"/>
        <owl1:Description>The system shall generate and maintain an AI-specific Software Bill of Materials (AI SBOM) documenting model files, training data sources, dependencies, and system architecture.</owl1:Description>
        <owl1:Name>AI SBOM Generation</owl1:Name>
        <owl1:Source>G7/CISA — &quot;Minimum Elements for AI Software Bills of Materials&quot; (June 2026)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑SBOM2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑SBOM2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SoftwareBillOfMaterialsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑SBOM2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SoftwareBillOfMaterialsRequirements"/>
        <owl1:Description>The system shall include cryptographic hash values in the AI SBOM to enable integrity verification of model files and detect unauthorised modifications.</owl1:Description>
        <owl1:Name>AI SBOM Integrity Verification</owl1:Name>
        <owl1:Source>G7/CISA — AI SBOM Minimum Elements</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑SBOM3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑SBOM3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SoftwareBillOfMaterialsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑SBOM3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SoftwareBillOfMaterialsRequirements"/>
        <owl1:Description>The system shall document license information and potential legal risks in the AI SBOM to enable informed risk assessment and compliance tracking.</owl1:Description>
        <owl1:Name>AI SBOM License and Risk Disclosure</owl1:Name>
        <owl1:Source>G7/CISA — AI SBOM Minimum Elements</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑SOS1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑SOS1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/CrossSystemInteractionRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑SOS1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/CrossSystemInteractionRequirements"/>
        <owl1:Description>The system shall ensure completeness of requirements that govern interactions between AI systems and existing systems, abstracting complexity using AI-driven approaches.</owl1:Description>
        <owl1:Name>Cross-system Interaction Completeness</owl1:Name>
        <owl1:Source>ScienceDirect — &quot;AI-Driven Agile Systems Engineering for Managing Cross-System Interactions&quot; (2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑SOS2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑SOS2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/CrossSystemInteractionRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑SOS2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/CrossSystemInteractionRequirements"/>
        <owl1:Description>The system shall address architecture and integration challenges such as interface compatibility, safety, and security in system of autonomous systems (SoAS) contexts.</owl1:Description>
        <owl1:Name>System of Autonomous Systems Integration</owl1:Name>
        <owl1:Source>INCOSE — &quot;Systems Engineering Methodology for System of Autonomous Systems&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑PROTO1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑PROTO1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/CommunicationProtocolsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑PROTO1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/CommunicationProtocolsRequirements"/>
        <owl1:Description>The system shall implement standardised AI Agent communication protocols enabling autonomous agents to exchange information and coordinate across the Internet.</owl1:Description>
        <owl1:Name>Standardised Agent Communication Framework</owl1:Name>
        <owl1:Source>IETF — &quot;Framework, Use Cases and Requirements for AI Agent Protocols&quot; (October 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑PROTO2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑PROTO2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/CommunicationProtocolsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑PROTO2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/CommunicationProtocolsRequirements"/>
        <owl1:Description>The system shall support cross-platform interoperability among AI agents through standardised discovery and invocation mechanisms.</owl1:Description>
        <owl1:Name>Cross-platform Agent Interoperability</owl1:Name>
        <owl1:Source>IETF — &quot;HTTP-Based AI Agent Discovery and Invocation Protocol&quot; (2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑TASK1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑TASK1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/TaskCoordinationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑TASK1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/TaskCoordinationRequirements"/>
        <owl1:Description>The system shall support dynamic task discovery, enabling agents to identify and accept new tasks in real-time across distributed environments.</owl1:Description>
        <owl1:Name>Dynamic Task Discovery</owl1:Name>
        <owl1:Source>IETF — &quot;Task-oriented Coordination Requirements for AI Agent Protocols&quot; (July 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑TASK2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑TASK2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/TaskCoordinationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑TASK2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/TaskCoordinationRequirements"/>
        <owl1:Description>The system shall support context-aware scheduling of tasks across AI agents, considering workload, capability, and environmental conditions.</owl1:Description>
        <owl1:Name>Context-aware Scheduling</owl1:Name>
        <owl1:Source>IETF — &quot;Task-oriented Coordination Requirements for AI Agent Protocols&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑TASK3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑TASK3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/TaskCoordinationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑AGENT‑TASK3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/TaskCoordinationRequirements"/>
        <owl1:Description>The system shall enable autonomous task negotiation between agents, allowing them to agree on task assignment, division, and execution parameters.</owl1:Description>
        <owl1:Name>Task Negotiation Capability</owl1:Name>
        <owl1:Source>IETF — &quot;Task-oriented Coordination Requirements for AI Agent Protocols&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑DISC1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑DISC1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AgentDiscovery&amp;InvocationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑DISC1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AgentDiscovery&amp;InvocationRequirements"/>
        <owl1:Description>The system shall provide a standard &quot;discover and match&quot; mechanism to enable cross-platform interoperability among AI agents.</owl1:Description>
        <owl1:Name>Cross-platform Agent Discovery</owl1:Name>
        <owl1:Source>IETF HTTP-Based AI Agent Discovery and Invocation Protocol (2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑DISC2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑DISC2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AgentDiscovery&amp;InvocationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑DISC2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AgentDiscovery&amp;InvocationRequirements"/>
        <owl1:Description>The system shall provide a unified invocation entry point via a standard HTTP-based API for all AI agents.</owl1:Description>
        <owl1:Name>Unified Invocation Entry Point</owl1:Name>
        <owl1:Source>IETF HTTP-Based AI Agent Discovery and Invocation Protocol (2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑DISC3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑DISC3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AgentDiscovery&amp;InvocationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑DISC3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AgentDiscovery&amp;InvocationRequirements"/>
        <owl1:Description>The system shall support AI agent discovery within and across domains using DNS lookup and other standardized mechanisms.</owl1:Description>
        <owl1:Name>Intra-domain and Inter-domain Discovery</owl1:Name>
        <owl1:Source>IETF AI Agents for 6G Requirements (September 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑MULT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑MULT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/MultimodalCommunicationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑MULT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/MultimodalCommunicationRequirements"/>
        <owl1:Description>The system shall enable autonomous agents to establish multi-channel communication sessions (e.g., text, file, real-time audio/video streams, sensor streams).</owl1:Description>
        <owl1:Name>Multi-channel Session Establishment</owl1:Name>
        <owl1:Source>IETF Multimodal Management Requirements for AI Agent Protocols (2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑MULT2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑MULT2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/MultimodalCommunicationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑AGNT‑MULT2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/MultimodalCommunicationRequirements"/>
        <owl1:Description>The system shall support negotiation of heterogeneous data capabilities between agents to exchange synchronized multimodal content.</owl1:Description>
        <owl1:Name>Multimodal Capability Negotiation</owl1:Name>
        <owl1:Source>IETF Multimodal Management Requirements for AI Agent Protocols (2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑DATA‑PROC1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑DATA‑PROC1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/PlatformDataProcessingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑DATA‑PROC1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/PlatformDataProcessingRequirements"/>
        <owl1:Description>The system shall meet data processing requirements for the AI cloud platform.</owl1:Description>
        <owl1:Name>Data Processing Requirements for AI Cloud Platform</owl1:Name>
        <owl1:Source>ITU-T F.AICP-DP General technical requirements and framework for AI cloud platform: data processing requirements (2025-2028)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR‑INF‑OPT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR‑INF‑OPT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/CloudPlatformRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR‑INF‑OPT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/CloudPlatformRequirements"/>
        <owl1:Description>The system shall support inference optimization requirements for the AI cloud platform.</owl1:Description>
        <owl1:Name>Inference Optimization for AI Cloud Platform</owl1:Name>
        <owl1:Source>ITU-T F.748.61 General technical requirements and framework for AI cloud platform - Inference optimization (Approved December 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/HumanResources&amp;PeopleTeams -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/HumanResources&amp;PeopleTeams">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanResources&amp;PeopleTeams"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
        <Interactions>All employees to build a culture of responsible AI and provide ongoing training.</Interactions>
        <Responsibilities>Promote AI awareness, train employees on responsible AI use, and address human factors such as bias and accountability.</Responsibilities>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/IT&amp;SecurityTeams -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/IT&amp;SecurityTeams">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/IT&amp;SecurityTeams"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
        <Interactions>Developers and deployers to integrate security into the AI lifecycle and respond to vulnerabilities.</Interactions>
        <Responsibilities>Implement technical controls to secure the AI infrastructure, protect data, and ensure system security.</Responsibilities>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/Leadership&amp;Executives -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/Leadership&amp;Executives">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/Leadership&amp;Executives"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
        <Interactions>All internal stakeholders to establish a culture of responsible AI and ensure top-down commitment.</Interactions>
        <Responsibilities>Set the vision for AI governance, allocate resources, and ensure AI strategies align with business objectives and ethical commitments.</Responsibilities>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑ACCT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑ACCT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Accountability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑ACCT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Accountability"/>
        <owl1:Description>The system shall enable clear attribution of responsibility for decisions, actions, and outcomes to specific entities (human or system).</owl1:Description>
        <owl1:Name>Responsibility Attribution</owl1:Name>
        <owl1:Source>Accountability is a key NFR for AI ethics and governance. (Classification and challenges of non-functional requirements in ML-enabled systems: A systematic literature review)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑ADAPT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑ADAPT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Adaptability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑ADAPT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Adaptability"/>
        <owl1:Description>The system shall maintain acceptable performance when deployed in different but related domains or contexts.</owl1:Description>
        <owl1:Name>Cross‑domain Adaptation</owl1:Name>
        <owl1:Source>Survey NFRs for ML systems (Table 5 Important NFRs for ML systems, as defined in the survey From: Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑ADAPT2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑ADAPT2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Adaptability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑ADAPT2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Adaptability"/>
        <owl1:Description>The system shall support domain adaptation techniques to enable a model trained on a source domain to be used effectively in a different but related domain.</owl1:Description>
        <owl1:Name>Domain Adaptation Capability</owl1:Name>
        <owl1:Source>Survey NFRs for ML systems (Table 5 Important NFRs for ML systems, as defined in the survey From: Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑ANAL1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑ANAL1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Analysability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑ANAL1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Analysability"/>
        <owl1:Description>The system shall enable maintainers to diagnose deficiencies or causes of failures, or to identify parts to be modified efficiently.</owl1:Description>
        <owl1:Name>Ease of Diagnosing Deficiencies</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Analysability subcharacteristic</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑ANAL2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑ANAL2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Analysability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑ANAL2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Analysability"/>
        <owl1:Description>The system shall provide capabilities to analyse the impact of potential changes on existing functionality.</owl1:Description>
        <owl1:Name>Impact Analysis Support</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Analysability</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑APPREC1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑APPREC1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AppropriatenessRecognizability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑APPREC1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AppropriatenessRecognizability"/>
        <owl1:Description>The system shall enable users to recognise whether the product is appropriate for their needs.</owl1:Description>
        <owl1:Name>Purpose Recognisability</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Appropriateness recognizability subcharacteristic</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑APPREC2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑APPREC2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AppropriatenessRecognizability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑APPREC2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AppropriatenessRecognizability"/>
        <owl1:Description>The system shall provide sufficient initial information to help users understand the product&apos;s suitability for their tasks.</owl1:Description>
        <owl1:Name>Initial Information Clarity</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Appropriateness recognizability</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑AUDIT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑AUDIT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Auditability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑AUDIT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Auditability"/>
        <owl1:Description>The system shall support independent review and examination of its processes, decisions, and data to verify compliance and correctness.</owl1:Description>
        <owl1:Name>Independent Review Capability</owl1:Name>
        <owl1:Source>Auditability is identified as an AI‑specific quality characteristics. (Quality Characteristics of a Software Platform for Human-AI Teaming in Smart Manufacturing)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑AUT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑AUT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Autonomy"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑AUT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Autonomy"/>
        <owl1:Description>The system shall operate independently within defined boundaries, making decisions and taking actions without constant human intervention.</owl1:Description>
        <owl1:Name>Independent Operation Capability</owl1:Name>
        <owl1:Source>Autonomy is a key characteristic of agentic AI systems. (From Goals to Aspects, Revisited: An NFR Pattern Language for Agentic AI Systems)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑AUTH1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑AUTH1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Authenticity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑AUTH1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Authenticity"/>
        <owl1:Description>The system shall ensure that data and outputs are genuine, verifiable, and have not been tampered with or forged.</owl1:Description>
        <owl1:Name>Data and Output Genuineness</owl1:Name>
        <owl1:Source>Authenticity relates to integrity and the ability to ensure data is real, accurate, and safeguarded. (Table 5 Important NFRs for ML systems, as defined in the survey
From: Non-functional requirements for machine learning: understanding current use and challenges among practitioners).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑CAP1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑CAP1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Capacity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑CAP1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Capacity"/>
        <owl1:Description>The system shall meet defined maximum limits for number of users, transactions, or data volume without performance degradation.</owl1:Description>
        <owl1:Name>Maximum Limits Specification</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Capacity subcharacteristic</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑CAP2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑CAP2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Capacity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑CAP2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Capacity"/>
        <owl1:Description>The system shall scale its capacity to handle increasing workloads by adding resources without significant performance loss.</owl1:Description>
        <owl1:Name>Scalable Resource Capacity</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Capacity</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑CC1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑CC1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/QualityInUse"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑CC1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/QualityInUse"/>
        <owl1:Description>The system shall be used with effectiveness, efficiency, freedom from risk, and satisfaction in all specified contexts of use.</owl1:Description>
        <owl1:Name>Effectiveness in Specified Contexts</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Context coverage subcharacteristic</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑CC2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑CC2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/QualityInUse"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑CC2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/QualityInUse"/>
        <owl1:Description>The system shall ensure that the specified contexts of use cover all intended operational scenarios.</owl1:Description>
        <owl1:Name>Context Completeness</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Context coverage</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑COEX1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑COEX1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Co-existence"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑COEX1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Co-existence"/>
        <owl1:Description>The system shall co-exist with other independent systems in the same environment without negatively impacting their performance or functionality.</owl1:Description>
        <owl1:Name>Co-existence With other Systems</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Co-existence subcharacteristic</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑COEX2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑COEX2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Co-existence"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑COEX2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Co-existence"/>
        <owl1:Description>The system shall share hardware, software, or environmental resources with other systems without causing conflicts or degradation.</owl1:Description>
        <owl1:Name>Resource Sharing Without Conflict</owl1:Name>
        <owl1:Source>The system shall share hardware, software, or environmental resources with other systems without causing conflicts or degradation.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑COM1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑COM1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Compatibility"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑COM1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Compatibility"/>
        <owl1:Description>The system shall exchange data and information with other systems effectively using standardised formats and protocols.</owl1:Description>
        <owl1:Name>Cross-system Data Exchange</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Interoperability subcharacteristic</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑COM2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑COM2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Compatibility"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑COM2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Compatibility"/>
        <owl1:Description>The system shall perform required functions while sharing the same hardware or software environment with other systems.</owl1:Description>
        <owl1:Name>Shared Environment Functionality</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Interoperability</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑COMP1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑COMP1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Composability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑COMP1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Composability"/>
        <owl1:Description>The system shall support the assembly and reassembly of AI components as technology evolves.</owl1:Description>
        <owl1:Name>Modular AI Component Assembly</owl1:Name>
        <owl1:Source>Composable AI (https://www.uniphore.com/insights/composable-ai/)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑COMP2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑COMP2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Composability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑COMP2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Composability"/>
        <owl1:Description>The system shall provide modular, interoperable components that can be integrated across different AI frameworks and platforms.</owl1:Description>
        <owl1:Name>Interoperable Component Interfaces</owl1:Name>
        <owl1:Source>Composable AI (https://www.uniphore.com/insights/composable-ai/)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑COMPL1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑COMPL1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Completeness"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑COMPL1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Completeness"/>
        <owl1:Description>The system shall ensure that available data is comprehensive enough to address specific information requirements.</owl1:Description>
        <owl1:Name>Data Comprehensiveness</owl1:Name>
        <owl1:Source>Survey NFRs for ML systems (Table 5 Important NFRs for ML systems, as defined in the survey
From: Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑COMPL2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑COMPL2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Completeness"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑COMPL2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Completeness"/>
        <owl1:Description>The system shall verify that training datasets are complete and representative of the intended domain.</owl1:Description>
        <owl1:Name>Dataset Completeness Verification</owl1:Name>
        <owl1:Source>Survey NFRs for ML systems (Table 5 Important NFRs for ML systems, as defined in the survey
From: Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑COMPLEX1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑COMPLEX1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Complexity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑COMPLEX1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Complexity"/>
        <owl1:Description>The system shall manage complexity arising from many components, interrelations, or interactions, ensuring the system remains understandable.</owl1:Description>
        <owl1:Name>Component Interrelation Management</owl1:Name>
        <owl1:Source>Habibullah &amp; Horkoff (2023) — NFR clustering study (DOI:10.1007/s00766-022-00395-3,
Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑CONF1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑CONF1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Confidence"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑CONF1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Confidence"/>
        <owl1:Description>The system shall provide indications of its confidence or certainty in its outputs and decisions, enabling appropriate user trust.</owl1:Description>
        <owl1:Name>Output Certainty Indication</owl1:Name>
        <owl1:Source>Confidence scoring is critical for AI systems, particularly in high‑stakes applications (Non-Functional Requirements for Machine Learning Systems,
Doctoral thesis, 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑CORR1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑CORR1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Correctness"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑CORR1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Correctness"/>
        <owl1:Description>The system shall ensure that its outputs match the expectations outlined in the requirements, and that the system operates without failure.</owl1:Description>
        <owl1:Name>Output‑requirement Alignment</owl1:Name>
        <owl1:Source>Habibullah &amp; Horkoff (2023) — &quot;Important NFRs for ML systems&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑COST1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑COST1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/CostManagement"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑COST1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/CostManagement"/>
        <owl1:Description>The system shall manage and track token consumption for LLM operations, alerting when budgets are exceeded.</owl1:Description>
        <owl1:Name>Token Budget Management</owl1:Name>
        <owl1:Source>arXiv:2603.00472v1 (&quot;From Goals to Aspects, Revisited: An NFR Pattern Language for Agentic AI Systems&quot;)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑COST2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑COST2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/CostManagement"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑COST2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/CostManagement"/>
        <owl1:Description>The system shall attribute costs to specific users, sessions, or use cases for financial accountability.</owl1:Description>
        <owl1:Name>Cost Attribution</owl1:Name>
        <owl1:Source>arXiv:2603.00472v1 (&quot;From Goals to Aspects, Revisited: An NFR Pattern Language for Agentic AI Systems&quot;)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑CULT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑CULT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Cultural"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑CULT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Cultural"/>
        <owl1:Description>The system shall respect and adapt to the cultural norms, values, and practices of the communities it serves.</owl1:Description>
        <owl1:Name>Cultural Sensitivity and Appropriateness</owl1:Name>
        <owl1:Source>Cultural concerns are part of SLEEC requirements</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑D1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑D1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Dependability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑D1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Dependability"/>
        <owl1:Description>The system shall be dependable, integrating reliability, availability, safety, security, and maintainability to ensure consistent, trustworthy operation.</owl1:Description>
        <owl1:Name>Overall System Trustworthiness</owl1:Name>
        <owl1:Source>A new class of NFRs related to dependability has become increasingly important. (Classification and challenges of non-functional requirements in ML-enabled systems: A systematic literature review).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑EFF1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑EFF1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Efficiency"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑EFF1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Efficiency"/>
        <owl1:Description>The system shall accomplish tasks with minimal time, computational resources, energy, and effort.</owl1:Description>
        <owl1:Name>Resource Utilisation Efficiency</owl1:Name>
        <owl1:Source>Efficiency is defined as the ability to accomplish something with minimal time and effort (Table 5 Important NFRs for ML systems, as defined in the survey
From: Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑EMP1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑EMP1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Empathetic"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑EMP1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Empathetic"/>
        <owl1:Description>The system shall demonstrate understanding of and responsiveness to the emotional states and needs of its users.</owl1:Description>
        <owl1:Name>Empathetic Interaction Capability</owl1:Name>
        <owl1:Source>Empathetic concerns are part of SLEEC requirements</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑ETH1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑ETH1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/EthicalPractices"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑ETH1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/EthicalPractices"/>
        <owl1:Description>The system shall integrate ethical principles throughout the entire development lifecycle</owl1:Description>
        <owl1:Name>Integration of Ethical Principles</owl1:Name>
        <owl1:Source>Continuous assessment-driven requirement elicitation for trustworthy AI systems (ZHAW, 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑ETH2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑ETH2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/EthicalPractices"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑ETH2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/EthicalPractices"/>
        <owl1:Description>The system shall support ethical audits to ensure it aligns with organizational values, legal obligations, and societal expectations</owl1:Description>
        <owl1:Name>Ethical Audit Capability</owl1:Name>
        <owl1:Source>BCS, &quot;How AI could affect approaching non‑functional requirements&quot; (2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑ETH3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑ETH3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/EthicalPractices"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑ETH3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/EthicalPractices"/>
        <owl1:Description>The system shall provide mechanisms to identify and address societal concerns and ethical considerations that could potentially harm individuals and society</owl1:Description>
        <owl1:Name>Societal and Ethical concern Identification</owl1:Name>
        <owl1:Source>ISO/IEC CD TS 22443 (2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑ETH4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑ETH4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/EthicalPractices"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑ETH4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/EthicalPractices"/>
        <owl1:Description>The system shall comply with organizational governance criteria such as safety, transparency, accountability, responsibility, and minimizing bias</owl1:Description>
        <owl1:Name>Organizational Ethics Criteria</owl1:Name>
        <owl1:Source>IEEE P2863/D1, &quot;Recommended Practice for Organizational Governance of Artificial Intelligence&quot; (July 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑EX1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑EX1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Explainability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑EX1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Explainability"/>
        <owl1:Description>The system shall provide explanations tailored to different stakeholder groups (developers, end-users, regulators).</owl1:Description>
        <owl1:Name>Stakeholder-specific Explanations</owl1:Name>
        <owl1:Source>BCS (2025) (How AI could affect approaching non-functional requirements)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑EX2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑EX2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Explainability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑EX2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Explainability"/>
        <owl1:Description>The system shall enable tracing of AI decisions back to input data, model version, and reasoning steps.</owl1:Description>
        <owl1:Name>Decision Traceability</owl1:Name>
        <owl1:Source>NIST Trustworthy AI</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑EXP1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑EXP1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Trustworthiness"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑EXP1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Trustworthiness"/>
        <owl1:Description>The system shall provide explanations tailored to different stakeholder groups (developers, end-users, regulators).</owl1:Description>
        <owl1:Name>Stakeholder-specific Explanations</owl1:Name>
        <owl1:Source>BCS (2025) (&quot;How AI could affect approaching non-functional requirements&quot;)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑EXP2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑EXP2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Trustworthiness"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑EXP2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Trustworthiness"/>
        <owl1:Description>The system shall enable tracing of AI decisions back to input data, model version, and reasoning steps.</owl1:Description>
        <owl1:Name>Decision Traceability</owl1:Name>
        <owl1:Source>NIST Trustworthy AI</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑FLEX1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑FLEX1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Flexibility"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑FLEX1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Flexibility"/>
        <owl1:Description>The system shall react to changing demands or conditions without requiring significant rework.</owl1:Description>
        <owl1:Name>Changing Conditions Adaptability</owl1:Name>
        <owl1:Source>Habibullah &amp; Horkoff (2023) — &quot;Important NFRs for ML systems&quot; (DOI:10.1007/s00766-022-00395-3Corpus ID: 255538129
Non-functional requirements for machine learning: understanding current use and challenges among practitioners).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑FT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑FT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/FaultTolerance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑FT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/FaultTolerance"/>
        <owl1:Description>The system shall maintain core functionality when components fail, degrading gracefully rather than failing completely.</owl1:Description>
        <owl1:Name>Graceful Degradation</owl1:Name>
        <owl1:Source>arXiv:2603.00472v1 (From Goals to Aspects, Revisited: An NFR Pattern Language for Agentic AI Systems)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑FT2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑FT2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/FaultTolerance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑FT2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/FaultTolerance"/>
        <owl1:Description>The system shall implement error recovery mechanisms for agent failures, including retry logic and fallback strategies.</owl1:Description>
        <owl1:Name>Error Recovery</owl1:Name>
        <owl1:Source>General Best Practice</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑GENERAL1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑GENERAL1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Generalizability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑GENERAL1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Generalizability"/>
        <owl1:Description>The system shall maintain acceptable performance when applied to unseen data or scenarios not encountered during training.</owl1:Description>
        <owl1:Name>Unseen Data Performance</owl1:Name>
        <owl1:Source>Quality attributes in AI‑ML‑based systems (DOI:10.1007/s00766-022-00395-3;
Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑GOV1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑GOV1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/OrganisationalGovernance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑GOV1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/OrganisationalGovernance"/>
        <owl1:Description>The system shall be developed within an AI management system that establishes, implements, and continuously improves AI governance</owl1:Description>
        <owl1:Name>AI Management System Implementation</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2025</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑GOV2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑GOV2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/OrganisationalGovernance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑GOV2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/OrganisationalGovernance"/>
        <owl1:Description>The system&apos;s governance framework shall include verification protocols covering user agency, traceability, anti-simulation safeguards, and accountability chains</owl1:Description>
        <owl1:Name>User Agency and Accountability Chains</owl1:Name>
        <owl1:Source>&quot;The Standardized Definition of AI Governance&quot; (2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑HR1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑HR1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Democracy&amp;RuleOfLaw"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑HR1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Democracy&amp;RuleOfLaw"/>
        <owl1:Description>The system shall ensure that activities within the lifecycle of AI systems are fully consistent with human rights, democracy, and the rule of law.</owl1:Description>
        <owl1:Name>Human Rights Alignment</owl1:Name>
        <owl1:Source>Council of Europe Framework Convention on AI and Human Rights (CETS No. 225)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑HR2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑HR2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Democracy&amp;RuleOfLaw"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑HR2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Democracy&amp;RuleOfLaw"/>
        <owl1:Description>The system shall guarantee that every stage of the AI system&apos;s lifecycle respects and protects fundamental rights, democracy, and the rule of law.</owl1:Description>
        <owl1:Name>Fundamental Rights Protection</owl1:Name>
        <owl1:Source>Council of Europe Framework Convention</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑HR3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑HR3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Democracy&amp;RuleOfLaw"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑HR3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Democracy&amp;RuleOfLaw"/>
        <owl1:Description>The system shall implement safety-by-design for all AI products used by children and prohibit AI uses that carry a serious risk of human rights violations.</owl1:Description>
        <owl1:Name>Safety-by-design for Vulnerable Groups</owl1:Name>
        <owl1:Source>Council of Europe Commissioner for Human Rights (March 2026)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑INST1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑INST1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Installability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑INST1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Installability"/>
        <owl1:Description>The system shall be installed successfully and uninstalled completely in specified environments.</owl1:Description>
        <owl1:Name>Successful Installation</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Installability subcharacteristic</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑INST2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑INST2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Installability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑INST2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Installability"/>
        <owl1:Description>The system shall support automated or scripted installation processes to reduce manual effort and errors.</owl1:Description>
        <owl1:Name>Installation Automation</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Installability</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑INTEROP1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑INTEROP1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Interoperability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑INTEROP1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Interoperability"/>
        <owl1:Description>The system shall effectively communicate and exchange data with other systems and components.</owl1:Description>
        <owl1:Name>System-to-system Communication</owl1:Name>
        <owl1:Source>Survey NFRs for ML systems(Table 5 Important NFRs for ML systems, as defined in the survey From: Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑JUST1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑JUST1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Justifiability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑JUST1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Justifiability"/>
        <owl1:Description>The system shall demonstrate that its outputs are right or reasonable.</owl1:Description>
        <owl1:Name>Output Justification</owl1:Name>
        <owl1:Source>Survey NFRs for ML systems (Table 5 Important NFRs for ML systems, as defined in the survey
From: Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑JUST2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑JUST2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Justifiability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑JUST2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Justifiability"/>
        <owl1:Description>The system shall provide justification for decisions made by the AI system.</owl1:Description>
        <owl1:Name>Decision Justification</owl1:Name>
        <owl1:Source>Survey NFRs for ML systems (Table 5 Important NFRs for ML systems, as defined in the survey
From: Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑LIT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑LIT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/LiteracyRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑LIT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/LiteracyRequirements"/>
        <owl1:Description>The system shall support AI literacy obligations by ensuring that personnel operating the AI system have adequate knowledge and understanding of AI technologies, risks, and ethical considerations.</owl1:Description>
        <owl1:Name>AI Literacy Obligations</owl1:Name>
        <owl1:Source>EU AI Act — AI literacy obligations (effective 2 February 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑LRC1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑LRC1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/RegulatoryCompliance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑LRC1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/RegulatoryCompliance"/>
        <owl1:Description>The system shall comply with applicable regulatory frameworks across different jurisdictions, including the EU AI Act, NIST AI RMF, and other international regulations</owl1:Description>
        <owl1:Name>Multi‑jurisdictional Regulatory Compliance</owl1:Name>
        <owl1:Source>OpenMetadata Governance Framework</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑LRC2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑LRC2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/RegulatoryCompliance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑LRC2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/RegulatoryCompliance"/>
        <owl1:Description>The system shall support detailed documentation, risk assessments, and ongoing compliance tracking as required by regulations</owl1:Description>
        <owl1:Name>Detailed Documentation and Risk Assessments</owl1:Name>
        <owl1:Source>OpenMetadata Governance Framework</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑MOD1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑MOD1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Maintainability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑MOD1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Maintainability"/>
        <owl1:Description>The system shall support composability of AI components (models, data pipelines, preprocessing steps) allowing independent development and updates.</owl1:Description>
        <owl1:Name>Component Composability</owl1:Name>
        <owl1:Source>Chalmers University Research (2025) (Non-Functional Requirements for Machine Learning Systems)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑MOD2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑MOD2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Maintainability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑MOD2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Maintainability"/>
        <owl1:Description>The system shall implement standardized interfaces between AI components to enable plug-and-play integration and replacement.</owl1:Description>
        <owl1:Name>Interface Standardization</owl1:Name>
        <owl1:Source>General Best Practice</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑MODIF1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑MODIF1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Modifiability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑MODIF1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Modifiability"/>
        <owl1:Description>The system shall enable modifications to be implemented effectively and efficiently without introducing defects.</owl1:Description>
        <owl1:Name>Ease of Modification</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Modifiability subcharacteristic</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑MODIF2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑MODIF2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Modifiability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑MODIF2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Modifiability"/>
        <owl1:Description>The system shall support changes that do not break existing functionality or require extensive rework.</owl1:Description>
        <owl1:Name>Non-breaking Changes</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Modifiability</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑OBJ1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑OBJ1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Objectivity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑OBJ1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Objectivity"/>
        <owl1:Description>The system shall make decisions and produce outputs that are free from subjective or prejudiced influences.</owl1:Description>
        <owl1:Name>Bias‑free Decision‑making</owl1:Name>
        <owl1:Source>Objectivity is closely related to bias prevention and fairness. (Table 5 Important NFRs for ML systems, as defined in the survey; Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑OPACITY1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑OPACITY1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Opacity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑OPACITY1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Opacity"/>
        <owl1:Description>The system shall avoid being opaque; its internal workings and decision‑making processes shall be made understandable to relevant stakeholders.</owl1:Description>
        <owl1:Name>System Transparency</owl1:Name>
        <owl1:Source>DTIC — Requirements Engineering for Ethical AI</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑PA1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑PA1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/PublicAdministration"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑PA1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/PublicAdministration"/>
        <owl1:Description>The system shall comply with national laws and regulations governing the research, development, adoption, and application of AI systems and models</owl1:Description>
        <owl1:Name>Government AI Law Compliance</owl1:Name>
        <owl1:Source>Italy Law No. 132/2025 on Artificial Intelligence (effective October 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑PA2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑PA2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/PublicAdministration"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑PA2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/PublicAdministration"/>
        <owl1:Description>The system shall ensure AI systems used in public administration are aligned with European and national laws, particularly the EU AI Act</owl1:Description>
        <owl1:Name>Public Administration AI Alignment</owl1:Name>
        <owl1:Source>&quot;Le linee guida per l&apos;adozione della IA nella PA&quot; (Italy, 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑PERF1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑PERF1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Performance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑PERF1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Performance"/>
        <owl1:Description>The system shall meet defined latency requirements for inference operations based on use case (real-time, near-real-time, batch).</owl1:Description>
        <owl1:Name>Inference Latency</owl1:Name>
        <owl1:Source>Systematic Mapping Study (DOAJ)(Systematic mapping of non-functional requirements and their impacts in architectures for artificial intelligence)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑PERF2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑PERF2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Performance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑PERF2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Performance"/>
        <owl1:Description>The system shall achieve defined throughput targets for model training operations.</owl1:Description>
        <owl1:Name>Training Throughput</owl1:Name>
        <owl1:Source>General Best Practice</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑PORT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑PORT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Portability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑PORT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Portability"/>
        <owl1:Description>The system shall be transferable from one environment to another with minimal reconfiguration.</owl1:Description>
        <owl1:Name>Cross‑environment Transfer</owl1:Name>
        <owl1:Source>Survey NFRs for ML systems (Table 5 Important NFRs for ML systems, as defined in the survey From: Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑PORT2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑PORT2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Portability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑PORT2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Portability"/>
        <owl1:Description>The system shall support portable artifacts that encapsulate identity, behavior, tools, permissions, and runtime policy in a single versioned unit.</owl1:Description>
        <owl1:Name>Portable AI Artifacts</owl1:Name>
        <owl1:Source>Portable Agents (https://dev.to/saivishwak/portable-agents-are-the-missing-abstraction-in-ai-infrastructure-341n)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑REC1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑REC1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Recoverability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑REC1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Recoverability"/>
        <owl1:Description>The system shall recover the data and re-establish the desired state of the system after an interruption or failure.</owl1:Description>
        <owl1:Name>Automatic Recovery Capability</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Recoverability subcharacteristic</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑REC2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑REC2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Recoverability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑REC2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Recoverability"/>
        <owl1:Description>The system shall restore full functionality within defined time objectives after a failure, based on criticality classification.</owl1:Description>
        <owl1:Name>Restoration Time Objectives</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Recoverability</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑REPEAT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑REPEAT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Repeatability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑REPEAT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Repeatability"/>
        <owl1:Description>The system shall produce consistent results when the same algorithm is run on the same dataset under identical conditions.</owl1:Description>
        <owl1:Name>Consistent Results under Same Conditions</owl1:Name>
        <owl1:Source>Survey NFRs for ML systems (Table 5 Important NFRs for ML systems, as defined in the survey, From: Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑REPL1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑REPL1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Replaceability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑REPL1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Replaceability"/>
        <owl1:Description>The system shall enable the replacement of a specified software product by another in the same environment without disruption.</owl1:Description>
        <owl1:Name>Product Replacement Capability</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Replaceability subcharacteristic</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑REPL2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑REPL2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Replaceability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑REPL2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Replaceability"/>
        <owl1:Description>The system shall support seamless upgrades and replacements with minimal downtime and data migration.</owl1:Description>
        <owl1:Name>Upgrade Path Support</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – Replaceability</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑REPROD1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑REPROD1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Reproducibility"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑REPROD1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Reproducibility"/>
        <owl1:Description>The system shall produce the same (or similar) results when the same algorithm is run on the same dataset under the same conditions.</owl1:Description>
        <owl1:Name>Consistent Result Replication</owl1:Name>
        <owl1:Source>Reproducibility means repeatedly running an algorithm on certain datasets to obtain the same (or similar) results. (Table 5 Important NFRs for ML systems, as defined in the survey
From: Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑RET1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑RET1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Retrainability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑RET1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Retrainability"/>
        <owl1:Description>The system shall support periodic retraining using new data without requiring full system redeployment.</owl1:Description>
        <owl1:Name>Periodic Retraining Capability</owl1:Name>
        <owl1:Source>Chalmers University Research (2025) (Non-Functional Requirements for Machine Learning Systems)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑RET2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑RET2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Retrainability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑RET2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Retrainability"/>
        <owl1:Description>The system shall maintain quality and integrity of the retraining pipeline, including data versioning, model versioning, and validation of retrained models before deployment.</owl1:Description>
        <owl1:Name>Retraining Pipeline Quality</owl1:Name>
        <owl1:Source>REFSQ 2024 (Documentation of non-functional requirements for systems with machine learning components)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑RET3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑RET3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Retrainability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑RET3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Retrainability"/>
        <owl1:Description>The system shall support incremental learning or efficient fine-tuning to minimize computational costs and downtime during model updates.</owl1:Description>
        <owl1:Name>Efficient Model Updates</owl1:Name>
        <owl1:Source>Chalmers University Research (2025) (Non-Functional Requirements for Machine Learning Systems)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑ROB1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑ROB1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Robustness"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑ROB1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Robustness"/>
        <owl1:Description>The system shall maintain acceptable performance under adverse conditions, including noisy data, adversarial inputs, and unexpected scenarios.</owl1:Description>
        <owl1:Name>Resilience to Adverse Conditions</owl1:Name>
        <owl1:Source>Robustness is a key NFR for AI systems. (Non-Functional Requirements for Machine Learning Systems, Doctoral thesis, 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑SCAL1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑SCAL1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Scalability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑SCAL1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Scalability"/>
        <owl1:Description>The system shall support both horizontal scaling (adding more nodes) and vertical scaling (adding more resources to existing nodes) for training and inference workloads.</owl1:Description>
        <owl1:Name>Horizontal and Vertical Scaling</owl1:Name>
        <owl1:Source>Systematic Mapping Study (DOAJ) (Systematic mapping of non-functional requirements and their impacts in architectures for artificial intelligence)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑SCAL2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑SCAL2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Scalability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑SCAL2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Scalability"/>
        <owl1:Description>The system shall maintain performance as training datasets grow in size and complexity.</owl1:Description>
        <owl1:Name>Data Scalability</owl1:Name>
        <owl1:Source>Systematic Mapping Study (DOAJ) (Systematic mapping of non-functional requirements and their impacts in architectures for artificial intelligence)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑SOC1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑SOC1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SocialRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑SOC1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SocialRequirements"/>
        <owl1:Description>The system shall operate in a manner that is acceptable to the society in which it is deployed, respecting social norms and values.</owl1:Description>
        <owl1:Name>Social Acceptability</owl1:Name>
        <owl1:Source>Social concerns are part of SLEEC (Social, Legal, Ethical, Empathetic, and Cultural) requirements for autonomous agents</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑TRACE1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑TRACE1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Traceability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑TRACE1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Traceability"/>
        <owl1:Description>The system shall enable tracing of work items across the entire development lifecycle.</owl1:Description>
        <owl1:Name>End‑to‑end Traceability</owl1:Name>
        <owl1:Source>Survey NFRs for ML systems (Table 5 Important NFRs for ML systems, as defined in the survey
From: Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑TRACE2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑TRACE2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Traceability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑TRACE2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Traceability"/>
        <owl1:Description>The system shall enable tracing of AI decisions back to input data, model version, and reasoning steps.</owl1:Description>
        <owl1:Name>Decision Traceability</owl1:Name>
        <owl1:Source>NIST Trustworthy AI</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑TRAIN1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑TRAIN1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Trainability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑TRAIN1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Trainability"/>
        <owl1:Description>The system shall support effective and efficient model training, including the ability to be trained on new data without excessive computational cost.</owl1:Description>
        <owl1:Name>Effective Model Training</owl1:Name>
        <owl1:Source>Quality attributes in AI‑ML‑based systems (DOI:10.1007/s00766-022-00395-3;
Non-functional requirements for machine learning: understanding current use and challenges among practitioners)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑TRUST1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑TRUST1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Trust"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑TRUST1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Trust"/>
        <owl1:Description>The system shall be relied upon to a specified extent to enforce a specified security or security policy.</owl1:Description>
        <owl1:Name>Policy Enforcement</owl1:Name>
        <owl1:Source>Habibullah &amp; Horkoff (2023) — &quot;Important NFRs for ML systems&quot;; Edge AI dependability framework.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑UIA1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑UIA1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/UserInterfaceDesign"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑UIA1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/UserInterfaceDesign"/>
        <owl1:Description>The system shall provide a user interface that is pleasing and engaging to users through appropriate visual design.</owl1:Description>
        <owl1:Name>Pleasing User Interface</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – User interface aesthetics subcharacteristic</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑UIA2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑UIA2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/UserInterfaceDesign"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑UIA2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/UserInterfaceDesign"/>
        <owl1:Description>The system shall maintain consistent visual design, layout, and interaction patterns across all screens and modules.</owl1:Description>
        <owl1:Name>Consistent Interface Design</owl1:Name>
        <owl1:Source>ISO/IEC 25010:2023 – User interface aesthetics</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑USAB1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑USAB1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Usability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑USAB1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Usability"/>
        <owl1:Description>The system shall provide interfaces that enable non-expert users to effectively interact with and understand AI outputs.</owl1:Description>
        <owl1:Name>User-friendly AI Interaction</owl1:Name>
        <owl1:Source>Systematic Mapping Study (DOAJ) (Systematic mapping of non-functional requirements and their impacts in architectures for artificial intelligence)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑USAB2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑USAB2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Usability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑USAB2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Usability"/>
        <owl1:Description>The system shall provide sufficient information (confidence scores, explanations) to enable users to develop appropriate trust in AI outputs.</owl1:Description>
        <owl1:Name>Trust and Confidence</owl1:Name>
        <owl1:Source>General Best Practice</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑WP1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑WP1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Workforce&amp;WorkerProtection"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑WP1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Workforce&amp;WorkerProtection"/>
        <owl1:Description>The system shall ensure that AI use in the workplace adheres to principles of safety, reliability, transparency, and respect for human dignity and data confidentiality.</owl1:Description>
        <owl1:Name>AI Workplace Safety and Dignity</owl1:Name>
        <owl1:Source>Italy Law No. 132/2025 on Artificial Intelligence</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑WP2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑WP2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Workforce&amp;WorkerProtection"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑WP2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Workforce&amp;WorkerProtection"/>
        <owl1:Description>The system shall safeguard the physical and mental integrity of workers, enhance the quality of performance, and increase productivity in line with EU law.</owl1:Description>
        <owl1:Name>Worker Physical and Mental Integrity</owl1:Name>
        <owl1:Source>Italian Senate AI Bill</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑WP3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑WP3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Workforce&amp;WorkerProtection"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑WP3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Workforce&amp;WorkerProtection"/>
        <owl1:Description>The system shall ensure that AI does not discriminate in access to healthcare services and affirms the right of patients to be informed when AI tools are utilized in their care.</owl1:Description>
        <owl1:Name>Non-discrimination in AI Employment</owl1:Name>
        <owl1:Source>Italy Law No. 132/2025</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑AGNT‑AGILE1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑AGNT‑AGILE1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemAgility"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑AGNT‑AGILE1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemAgility"/>
        <owl1:Description>The system shall provide real-time adaptability to manage dynamic workloads across large-scale, heterogeneous networking environments.</owl1:Description>
        <owl1:Name>Real-time Adaptability to Dynamic Workloads</owl1:Name>
        <owl1:Source>IETF Task-oriented Coordination Requirements for AI Agent Protocols (2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/NFR‑AGNT‑QOS1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/NFR‑AGNT‑QOS1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/QualityOfService"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/NFR‑AGNT‑QOS1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/QualityOfService"/>
        <owl1:Description>The system shall support adaptive Quality of Service (QoS) policies for exchanging synchronized multimodal content.</owl1:Description>
        <owl1:Name>Adaptive QoS Policies for Multimodal Communication</owl1:Name>
        <owl1:Source>IETF Multimodal Management Requirements for AI Agent Protocols (2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/OpenClawCommand&amp;Control -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/OpenClawCommand&amp;Control">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AgenticAISystems"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hp/ontologies/Operators&amp;Monitors -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/Operators&amp;Monitors">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/Operators&amp;Monitors"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
        <Interactions>Deployers, end-users, and compliance teams to address operational issues and ensure system reliability.</Interactions>
        <Responsibilities>Oversee day-to-day system performance, monitor for errors or anomalies, and ensure the system operates as intended.</Responsibilities>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑AG1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑AG1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/FiveEyesAgenticAI"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑AG1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/FiveEyesAgenticAI"/>
        <owl1:Description>The system shall manage agent identity and permissions with the same rigor as human identities, enforcing least‑privilege access and preventing privilege escalation through agent delegation.</owl1:Description>
        <owl1:Name>Agent Privilege Management</owl1:Name>
        <owl1:Source>CISA/NSA Five Eyes Guidance – “Privilege” risk category for agentic AI</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑AG2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑AG2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/FiveEyesAgenticAI"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑AG2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/FiveEyesAgenticAI"/>
        <owl1:Description>The system shall continuously monitor agent decision steps, tool invocations, and action patterns to detect anomalous behaviors and potential misuse.</owl1:Description>
        <owl1:Name>Agent Behavioral Monitoring</owl1:Name>
        <owl1:Source>CISA/NSA Five Eyes Guidance – “Behavioral” risk category for agentic AI</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑AG3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑AG3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/FiveEyesAgenticAI"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑AG3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/FiveEyesAgenticAI"/>
        <owl1:Description>The system shall implement secure design patterns for agent architectures, including input validation for agent goals, tool permission boundaries, and human‑in‑the‑loop mechanisms for high‑risk actions.</owl1:Description>
        <owl1:Name>Agent Design &amp; Configuration Security</owl1:Name>
        <owl1:Source>CISA/NSA Five Eyes Guidance – “Design and configuration” risk category</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑AG4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑AG4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/FiveEyesAgenticAI"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑AG4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/FiveEyesAgenticAI"/>
        <owl1:Description>The system shall maintain comprehensive audit trails of all agent actions, including goal definitions, tool selections, parameter passing, and action outcomes, supporting forensic reconstruction.</owl1:Description>
        <owl1:Name>Agent Accountability &amp; Audit</owl1:Name>
        <owl1:Source>CISA/NSA Five Eyes Guidance – “Accountability” risk category</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑AG5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑AG5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/FiveEyesAgenticAI"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑AG5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/FiveEyesAgenticAI"/>
        <owl1:Description>The system shall architecturally segregate agents from each other and from critical systems, preventing lateral movement if an agent is compromised.</owl1:Description>
        <owl1:Name>Agent Structural Isolation</owl1:Name>
        <owl1:Source>CISA/NSA Five Eyes Guidance – “Structural” risk category</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑AVAIL1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑AVAIL1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemAvailability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑AVAIL1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemAvailability"/>
        <owl1:Description>The system shall implement high-availability requirements for AI cloud platforms, including monitoring capabilities, alerting capabilities, and operation capabilities for foundation model development.</owl1:Description>
        <owl1:Name>High-availability AI Cloud Platform</owl1:Name>
        <owl1:Source>ITU-T F.748.60 (12/2025) — &quot;General technical requirements and framework for artificial intelligence cloud platform – High availability requirements&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑AVAIL2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑AVAIL2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemAvailability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑AVAIL2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemAvailability"/>
        <owl1:Description>The system shall maintain 99.9% uptime for production inference systems with comprehensive disaster recovery and business continuity planning.</owl1:Description>
        <owl1:Name>Production Inference Uptime</owl1:Name>
        <owl1:Source>Compliance Frameworks for AI Infrastructure (December 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑AVAIL3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑AVAIL3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemAvailability"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑AVAIL3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemAvailability"/>
        <owl1:Description>The system shall ensure AI models produce accurate, complete, and timely results through validation and testing as part of availability requirements.</owl1:Description>
        <owl1:Name>Processing Integrity Assurance</owl1:Name>
        <owl1:Source>Compliance Frameworks for AI Infrastructure — &quot;Processing integrity ensures AI models produce accurate, complete, and timely results&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑CAP1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑CAP1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/NISTCyberAIProfile"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑CAP1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/NISTCyberAIProfile"/>
        <owl1:Description>The system shall align with the NIST Cyber AI Profile, applying the six core CSF functions (Govern, Identify, Protect, Detect, Respond, Recover) to AI systems across three focus areas: securing AI system components, conducting AI-enabled cyber defense, and thwarting AI-enabled cyber-attacks.</owl1:Description>
        <owl1:Name>CSF 2.0 Cyber AI Profile Compliance</owl1:Name>
        <owl1:Source>NIST Cyber AI Profile (Preliminary Draft, December 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑CAP2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑CAP2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/NISTCyberAIProfile"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑CAP2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/NISTCyberAIProfile"/>
        <owl1:Description>The system shall support AI-enabled cyber defense capabilities, using AI to enhance cybersecurity operations and proactively thwart AI threats.</owl1:Description>
        <owl1:Name>AI-enabled Cyber Defense</owl1:Name>
        <owl1:Source>NIST Cyber AI Profile</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑CONF1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑CONF1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemConfidentiality"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑CONF1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemConfidentiality"/>
        <owl1:Description>The system shall protect intellectual property rights, confidential business information, and trade secrets when providing information about the AI system.</owl1:Description>
        <owl1:Name>Protection of Confidential Information</owl1:Name>
        <owl1:Source>GPAI Code of Practice (10 July 2025) — &quot;Protection of confidential information&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑CONF2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑CONF2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemConfidentiality"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑CONF2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemConfidentiality"/>
        <owl1:Description>The system shall implement adequate and effective cybersecurity measures to protect the security and confidentiality of information and data obtained during AI system operation.</owl1:Description>
        <owl1:Name>AI-specific Confidentiality Measures</owl1:Name>
        <owl1:Source>EU AI Act Article 78 — &quot;Confidentiality&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑CONF3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑CONF3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemConfidentiality"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑CONF3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SystemConfidentiality"/>
        <owl1:Description>The system shall delete data collected as soon as it is no longer needed for the purpose for which it was obtained, ensuring confidentiality throughout the data lifecycle.</owl1:Description>
        <owl1:Name>Data Deletion after Use</owl1:Name>
        <owl1:Source>EU AI Act Article 78</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑NOND1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑NOND1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Non‑repudiation"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑NOND1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Non‑repudiation"/>
        <owl1:Description>The system shall provide evidence that a specific action or transaction occurred, preventing denial of involvement by any party.</owl1:Description>
        <owl1:Name>Action Accountability</owl1:Name>
        <owl1:Source>Non‑repudiation is a key security NFR ensuring accountability.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑SBOM1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑SBOM1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AI-SBOM-Security"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑SBOM1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AI-SBOM-Security"/>
        <owl1:Description>The system shall include cryptographic hash values in the AI SBOM to enable verification of model file integrity and detect tampering.</owl1:Description>
        <owl1:Name>AI SBOM Integrity Verification</owl1:Name>
        <owl1:Source>G7/CISA — &quot;Minimum Elements for AI Software Bills of Materials&quot; (June 2026)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑SBOM2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑SBOM2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AI-SBOM-Security"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑SBOM2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AI-SBOM-Security"/>
        <owl1:Description>The system shall use the AI SBOM to track vulnerabilities in AI components and enable rapid response to newly discovered CVEs.</owl1:Description>
        <owl1:Name>AI SBOM Vulnerability Tracking</owl1:Name>
        <owl1:Source>G7/CISA — AI SBOM Minimum Elements</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR‑SBOM3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR‑SBOM3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AI-SBOM-Security"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/SR‑SBOM3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AI-SBOM-Security"/>
        <owl1:Description>The system shall document license information for all AI components in the SBOM to enable legal risk assessment and compliance.</owl1:Description>
        <owl1:Name>AI SBOM License Compliance</owl1:Name>
        <owl1:Source>G7/CISA — AI SBOM Minimum Elements</owl1:Source>
    </owl:Axiom>
    


