    <rdf:Description>
        <Purpose>Identifies the system&apos;s security requirements by checking if they are defined by a Security Engineer stakeholder.</Purpose>
        <RuleID>R‑MAP‑STK‑001</RuleID>
        <owl1:Name>Security Stakeholder Classification</owl1:Name>
        <Condition:Inference>If a Stakeholder has role SecurityEngineer and defines a Requirements, then the requirement is classified as a SecurityRequirement</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasRole"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#SecurityEngineer"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/define"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#r"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SecurityRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Name>Requirement Accountability</Name>
        <Purpose>Infers which stakeholders in the system are accountable for which requirements based on assignment.</Purpose>
        <RuleID>R‑INF‑001</RuleID>
        <Condition:Inference>If a Requirement has an assigned stakeholder, then the stakeholder is accountableFor the requirement.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasAssignee"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#s"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/accountableFor"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Name>Full Traceability</Name>
        <Purpose>Infers which requirements in the system have complete traceability to stakeholders, phases, and assets.</Purpose>
        <RuleID>R‑INF‑009</RuleID>
        <Condition:Inference>If a Requirement has a stakeholder assignee, a lifecycle phase, and an asset relationship, then it hasFullTraceability.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasAssignee"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#s"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasPhase"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#p"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/governs"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                                <swrl:argument2 rdf:resource="urn:swrl:var#a"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/protects"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#a"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/constrains"/>
                                                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                                                <swrl:argument2 rdf:resource="urn:swrl:var#a"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasFullTraceability"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#true"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Name>Accessibility Keyword Classification</Name>
        <Purpose>Identifies the system&apos;s accessibility NFRs by checking for accessibility-related keywords.</Purpose>
        <RuleID>R‑CLS‑004</RuleID>
        <Condition:Inference>If a Requirement contains text accessibility, then it is classified as a NonFunctionalRequirements with category Accessibility.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/containsText"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#accessibility"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/NonFunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#Accessibility"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Name>Functional Requirement Classification</Name>
        <Purpose>Identifies the system&apos;s functional requirements by checking for &quot;shall&quot; statements without security or performance keywords.</Purpose>
        <RuleID>R‑CLS‑003</RuleID>
        <Condition:Inference>If a Requirement contains text shall and an action, and no security or performance keywords, then it is classified as a FunctionalRequirements.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/containsText"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#shall"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/notContainsText"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#&apos;encrypt;latency;performance&apos;"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Name>Agentic Keyword Classification</Name>
        <Purpose>Identifies the system&apos;s agentic AI requirements by checking for agent-related keywords.</Purpose>
        <RuleID>R‑CLS‑018</RuleID>
        <Condition:Inference>If a Requirement contains text agent or autonomous or tool invocation or multi-agent, then it is classified as a FunctionalRequirements with category AgenticAIRequirements.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/containsText"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#&apos;agent;autonomous;tool%20invocation;multi-agent&apos;"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Name>Data Governance Keyword Classification</Name>
        <Purpose>Identifies the system&apos;s data governance requirements by checking for data-related keywords.</Purpose>
        <RuleID>R‑CLS‑015</RuleID>
        <Condition:Inference>If a Requirement contains text data governance or data quality or data provenance or data lineage, then it is classified as a FunctionalRequirements with category DataManagementRequirements.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/containsText"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#&apos;data%20governance;data%20quality;data%20provenance;data%20lineage&apos;"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#DataManagementRequirements"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Name>Security Keyword Classification</Name>
        <Purpose>Identifies the system&apos;s security requirements by checking for security-related keywords in the requirement text.</Purpose>
        <RuleID>R‑CLS‑001</RuleID>
        <Condition:Inference>If a Requirement contains text encrypt or access or authentication or privacy or integrity or confidentiality or authorization or audit or security, then it is classified as a SecurityRequirements.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
