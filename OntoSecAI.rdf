    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-M4.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-M4.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelLifecycleRequirements"/>
        <owl1:Description>The system shall maintain version control for all deployed models.</owl1:Description>
