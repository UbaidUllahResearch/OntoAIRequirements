    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D5.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D5.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataManagementRequirements"/>
        <owl1:Description>The system shall automatically detect duplicates, outliers, missing values, and schema drift.</owl1:Description>
