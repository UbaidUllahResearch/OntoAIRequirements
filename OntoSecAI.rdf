    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-A1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SR-A1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdversarialRobustness"/>
