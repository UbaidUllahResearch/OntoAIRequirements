    <rdf:Description>
        <Name>Model Security Keyword Classification</Name>
        <Purpose>Identifies the system&apos;s model security requirements by checking for model-related security keywords.</Purpose>
        <RuleID>R‑CLS‑016</RuleID>
        <Condition:Inference>If a Requirement contains text model integrity or model tampering or model extraction or model stealing, then it is classified as a SecurityRequirements with category ModelSecurity.</Condition:Inference>
