    <!-- http://www.semanticweb.org/hp/ontologies/AI-BillOfMaterials -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/AI-BillOfMaterials">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ComplianceArtifacts"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hp/ontologies/AIDeployers -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/AIDeployers">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/AIDeployers"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
        <Interactions>End-users, IT/security teams, and system operators to ensure smooth deployment and address user feedback.</Interactions>
        <Responsibilities>Integrate AI into production, ensure compatibility with legacy systems, manage organizational change, and oversee user training.</Responsibilities>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/AIDevelopers -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/AIDevelopers">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/AIDevelopers"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
        <Interactions>Data providers, domain experts, legal teams, and impacted communities to define requirements and constraints.</Interactions>
        <Responsibilities>Define system objectives, design architecture, develop models, and ensure lawful and fit-for-purpose design.</Responsibilities>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/AuditLogs -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/AuditLogs">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ComplianceArtifacts"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hp/ontologies/CivilSociety -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/CivilSociety">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hp/ontologies/Cloud -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/Cloud">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/InfrastructureResources"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hp/ontologies/DataProviders -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/DataProviders">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/DataProviders"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
        <Interactions>Designers and developers, providing data and contextual understanding of its origin and limitations.</Interactions>
        <Responsibilities>Supply the data used for training, testing, and validating AI models.</Responsibilities>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/EndUser -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/EndUser">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/EndUser"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
        <Interactions>The AI system&apos;s interface. Their feedback is crucial for improvement and for identifying usability or performance issues.</Interactions>
        <Responsibilities>Interact with the AI system to perform tasks, relying on its outputs to inform decisions.</Responsibilities>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-ACC1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-ACC1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AccuracySpecificationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-ACC1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AccuracySpecificationRequirements"/>
        <owl1:Description>The system shall provide accuracy specifications and measurement methods for AI systems, including evaluation methods for NLP systems, classification, and regression tasks.</owl1:Description>
        <owl1:Name>Accuracy Measurement and Validation</owl1:Name>
        <owl1:Source>European Standardisation Request on AI — Accuracy specifications for AI systems; ISO/IEC JTC1/SC42 &quot;Evaluation methods for accurate natural language processing systems&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-AG1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-AG1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-AG1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAIRequirements"/>
        <owl1:Description>The system shall enforce human-in-the-loop approval for high-risk agent actions.</owl1:Description>
        <owl1:Name>Human-in-loop for High Risk</owl1:Name>
        <owl1:Source>OWASP Agentic AI Security Guidance.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-AG2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-AG2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-AG2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAIRequirements"/>
        <owl1:Description>The system shall validate tool execution permissions before agent invokes any external tool.</owl1:Description>
        <owl1:Name>Tool Permission Validation</owl1:Name>
        <owl1:Source>MITRE ATLAS (AML.T0051 – Agent-Based Execution).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-AG3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-AG3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-AG3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAIRequirements"/>
        <owl1:Description>The system shall log all agent decision steps (reasoning, tool selection, action taken, outcome).</owl1:Description>
        <owl1:Name>Agent Decision Logging</owl1:Name>
        <owl1:Source>OWASP Agentic AI Security Guidance.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-AG4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-AG4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-AG4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAIRequirements"/>
        <owl1:Description>The system shall limit agent autonomy to defined operational boundaries (e.g., read-only vs. read-write).</owl1:Description>
        <owl1:Name>Operational Boundary Enforcement</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM06:2025 – Excessive Agency).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-AG5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-AG5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-AG5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAIRequirements"/>
        <owl1:Description>The system shall detect multi-agent coordination attacks and anomalous cross-agent communications.</owl1:Description>
        <owl1:Name>Multi-agent Attack Detection</owl1:Name>
        <owl1:Source>MITRE ATLAS (Agent Technique).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-AG6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-AG6">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-AG6"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AgenticAIRequirements"/>
        <owl1:Description>The system shall enforce maximum iteration limits for agent loops to prevent infinite execution.</owl1:Description>
        <owl1:Name>Iteration Limits</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM10:2025 – Unbounded Consumption).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-COST1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-COST1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AICostGovernanceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-COST1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AICostGovernanceRequirements"/>
        <owl1:Description>The system shall track and attribute AI costs (API calls, compute, storage, tool invocations) at the use‑case, user, and session level to enable granular financial accountability.</owl1:Description>
        <owl1:Name>Per‑use‑case Cost Attribution</owl1:Name>
        <owl1:Source>FinOps for AI – Witness.ai (June 2026)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-COST2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-COST2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AICostGovernanceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-COST2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AICostGovernanceRequirements"/>
        <owl1:Description>The system shall support tiered budget models with post‑action enforcement, allowing organizations to set budgets by usage tier and enforce limits when thresholds are exceeded.</owl1:Description>
        <owl1:Name>Tiered Budget Enforcement</owl1:Name>
        <owl1:Source>Microsoft – ADR 0012: Cost Governance via Observability Policies (May 2026)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-COST3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-COST3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AICostGovernanceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-COST3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AICostGovernanceRequirements"/>
        <owl1:Description>The system shall provide real‑time visibility into AI spending before enforcing controls, enabling organizations to understand cost drivers and establish baseline usage patterns.</owl1:Description>
        <owl1:Name>Visibility Before Control</owl1:Name>
        <owl1:Source>Forbes – 5‑Layer Framework To Govern AI Token Spend (May 2026)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-COST4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-COST4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/AICostGovernanceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-COST4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/AICostGovernanceRequirements"/>
        <owl1:Description>The system shall provide specialized cost observability for agentic AI systems, tracking spending across LLM API calls, tool invocations, and external service usage to understand agent cost behavior.</owl1:Description>
        <owl1:Name>Agentic Cost Observability</owl1:Name>
        <owl1:Source>Finout – Agentic AI Cost Governance (June 2026)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-DOC1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-DOC1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TransparencyRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-DOC1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TransparencyRequirements"/>
        <owl1:Description>The system shall generate model cards documenting architecture, training data, intended use, performance, and limitations.</owl1:Description>
        <owl1:Name>Model Card Generation</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.8 (Documentation).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-DOC2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-DOC2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TransparencyRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-DOC2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TransparencyRequirements"/>
        <owl1:Description>The system shall provide human-readable system documentation including purpose, instructions, capabilities, and limitations for users.</owl1:Description>
        <owl1:Name>Human-readable Documentation</owl1:Name>
        <owl1:Source>EU AI Act, Article 13 (Transparency).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-DOC3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-DOC3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TransparencyRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-DOC3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TransparencyRequirements"/>
        <owl1:Description>The system shall maintain a public training data summary for GPAI models as per regulatory requirements.</owl1:Description>
        <owl1:Name>Public Training Summary (GPAI)</owl1:Name>
        <owl1:Source>EU AI Act GPAI Guidelines.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-DOC4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-DOC4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TransparencyRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-DOC4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#TransparencyRequirements"/>
        <owl1:Description>The system shall document copyright compliance policies applied to training data.</owl1:Description>
        <owl1:Name>Copyright Policy Documentation</owl1:Name>
        <owl1:Source>EU AI Act GPAI Guidelines.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-EDGE1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-EDGE1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Edge&amp;DistributedAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-EDGE1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Edge&amp;DistributedAIRequirements"/>
        <owl1:Description>The system shall support model partitioning – run part of model on edge, part on cloud.</owl1:Description>
        <owl1:Name>Model Partitioning</owl1:Name>
        <owl1:Source>General best practice for edge AI.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-EDGE2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-EDGE2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Edge&amp;DistributedAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-EDGE2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Edge&amp;DistributedAIRequirements"/>
        <owl1:Description>The system shall handle intermittent connectivity – queue inference requests when offline and sync later.</owl1:Description>
        <owl1:Name>Offline Queueing</owl1:Name>
        <owl1:Source>General best practice for edge AI.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-EDGE3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-EDGE3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Edge&amp;DistributedAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-EDGE3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Edge&amp;DistributedAIRequirements"/>
        <owl1:Description>The system shall support model compression (quantization, pruning, distillation) for edge deployment.</owl1:Description>
        <owl1:Name>Model Compression</owl1:Name>
        <owl1:Source>General best practice for edge AI.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-EDGE4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-EDGE4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Edge&amp;DistributedAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-EDGE4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Edge&amp;DistributedAIRequirements"/>
        <owl1:Description>The system shall allow federated learning – aggregate model updates from edge devices without raw data transfer.</owl1:Description>
        <owl1:Name>Federated Learning</owl1:Name>
        <owl1:Source>General best practice for privacy-preserving ML.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-ENS1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-ENS1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MultiModel&amp;EnsemblingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-ENS1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MultiModel&amp;EnsemblingRequirements"/>
        <owl1:Description>The system shall support ensemble strategies (voting, stacking, cascading) across multiple models.</owl1:Description>
        <owl1:Name>Ensemble Strategies</owl1:Name>
        <owl1:Source>General best practice for AI/ML.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-ENS2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-ENS2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MultiModel&amp;EnsemblingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-ENS2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MultiModel&amp;EnsemblingRequirements"/>
        <owl1:Description>The system shall allow dynamic model selection based on input characteristics.</owl1:Description>
        <owl1:Name>Dynamic Model Selection</owl1:Name>
        <owl1:Source>General best practice for AI/ML.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-ENS3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-ENS3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MultiModel&amp;EnsemblingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-ENS3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MultiModel&amp;EnsemblingRequirements"/>
        <owl1:Description>The system shall provide orchestration logic to handle model failures (fallback to secondary model).</owl1:Description>
        <owl1:Name>Failure Orchestration</owl1:Name>
        <owl1:Source>General best practice for resilience.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-ENS4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-ENS4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MultiModel&amp;EnsemblingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-ENS4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MultiModel&amp;EnsemblingRequirements"/>
        <owl1:Description>The system shall compare ensemble output to individual model outputs for drift detection.</owl1:Description>
        <owl1:Name>Ensemble Drift Comparison</owl1:Name>
        <owl1:Source>General best practice for MLOps</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-ENV1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-ENV1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/EnvironmentalSustainabilityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-ENV1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/EnvironmentalSustainabilityRequirements"/>
        <owl1:Description>The system shall be designed to minimize environmental impact and carbon footprint by optimizing resource usage, especially during model training and deployment phases.</owl1:Description>
        <owl1:Name>Energy Efficiency by Design</owl1:Name>
        <owl1:Source>MANOLO Project (Horizon Europe) – Sustainable AI</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-ENV2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-ENV2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/EnvironmentalSustainabilityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-ENV2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/EnvironmentalSustainabilityRequirements"/>
        <owl1:Description>The system shall measure and report key environmental indicators, including greenhouse gas emissions, energy consumption, water usage, e‑waste generation, and embedded material footprint of AI systems.</owl1:Description>
        <owl1:Name>Environmental Impact Reporting</owl1:Name>
        <owl1:Source>ITU‑T – Sustainable AI Measurement and Disclosure Frameworks</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-ENV3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-ENV3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/EnvironmentalSustainabilityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-ENV3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/EnvironmentalSustainabilityRequirements"/>
        <owl1:Description>The system shall measure direct energy consumption and water usage during both training and inference phases.</owl1:Description>
        <owl1:Name>Energy and Water Tracking</owl1:Name>
        <owl1:Source>UNE Specification for Sustainable AI (October 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-ENV4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-ENV4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/EnvironmentalSustainabilityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-ENV4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/EnvironmentalSustainabilityRequirements"/>
        <owl1:Description>The system shall account for resource use and emissions from design through deployment, operation, and end‑of‑life phases, including responsible disposal of hardware components.</owl1:Description>
        <owl1:Name>End‑of‑life Management</owl1:Name>
        <owl1:Source>UNESCO – STEP 3A Guidance (March 2026)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-EOL1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-EOL1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemEndOffLife"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-EOL1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemEndOffLife"/>
        <owl1:Description>The system shall securely retire AI models including removal from production, purging cached weights, and revoking access.</owl1:Description>
        <owl1:Name>Secure Model Retirement</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure End of Life Phase.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-EOL2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-EOL2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemEndOffLife"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-EOL2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemEndOffLife"/>
        <owl1:Description>The system shall provide model deprecation schedules with minimum advance notice to affected users.</owl1:Description>
        <owl1:Name>Deprecation Schedule</owl1:Name>
        <owl1:Source>General best practice for lifecycle management.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-EOL3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-EOL3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemEndOffLife"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-EOL3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemEndOffLife"/>
        <owl1:Description>The system shall securely archive retired models with encrypted backups for compliance retention.</owl1:Description>
        <owl1:Name>Encrypted Archival</owl1:Name>
        <owl1:Source>General best practice for retention.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-EOL4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-EOL4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemEndOffLife"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-EOL4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemEndOffLife"/>
        <owl1:Description>The system shall support model decommissioning without service disruption to active users.</owl1:Description>
        <owl1:Name>Disruption-free Decommissioning</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure End of Life Phase.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-EXP1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-EXP1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExperimentTrackingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-EXP1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExperimentTrackingRequirements"/>
        <owl1:Description>The system shall automatically capture code version, hyperparameters, environment dependencies, and random seeds per training run.</owl1:Description>
        <owl1:Name>Full Run Capture</owl1:Name>
        <owl1:Source>General best practice for reproducibility.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-EXP2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-EXP2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExperimentTrackingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-EXP2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExperimentTrackingRequirements"/>
        <owl1:Description>The system shall allow comparison of experiments side-by-side with metrics and artifacts.</owl1:Description>
        <owl1:Name>Side-by-side Comparison</owl1:Name>
        <owl1:Source>General best practice for MLOps.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-EXP3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-EXP3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExperimentTrackingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-EXP3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExperimentTrackingRequirements"/>
        <owl1:Description>The system shall support reproducing any past training run with a single command or API call.</owl1:Description>
        <owl1:Name>One-command Reproduction</owl1:Name>
        <owl1:Source>NIST SP 800-218A (Secure Development).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-EXP4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-EXP4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExperimentTrackingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-EXP4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ExperimentTrackingRequirements"/>
        <owl1:Description>The system shall record hardware/software stack (GPU type, driver version, CUDA, framework version).</owl1:Description>
        <owl1:Name>Hardware/software Stack Recording</owl1:Name>
        <owl1:Source>General best practice for reproducibility.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-F1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-F1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Fairness&amp;BiasRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-F1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Fairness&amp;BiasRequirements"/>
        <owl1:Description>The system shall compute fairness metrics (e.g., demographic parity, equalized odds, individual fairness) for protected attributes.</owl1:Description>
        <owl1:Name>Fairness Metric Computation</owl1:Name>
        <owl1:Source>NIST AI 100-1, Valid and Reliable (Fairness).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-F2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-F2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Fairness&amp;BiasRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-F2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Fairness&amp;BiasRequirements"/>
        <owl1:Description>The system shall allow bias audits by exporting intermediate predictions and feature contributions for specified subgroups.</owl1:Description>
        <owl1:Name>Bias Audit Export</owl1:Name>
        <owl1:Source>NIST AI 100-1, Measure function (auditability).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-F3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-F3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Fairness&amp;BiasRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-F3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Fairness&amp;BiasRequirements"/>
        <owl1:Description>The system shall support bias mitigation techniques (e.g., reweighting, post-processing calibration) as configurable pipeline steps.</owl1:Description>
        <owl1:Name>Configurable Bias Mitigation</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause 6.1 (Actions to address risks and opportunities).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-F4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-F4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Fairness&amp;BiasRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-F4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Fairness&amp;BiasRequirements"/>
        <owl1:Description>The system shall flag potential disparate impact when output distributions differ significantly across groups.</owl1:Description>
        <owl1:Name>Disparate Impact Flagging</owl1:Name>
        <owl1:Source>General best practice for fairness.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-F5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-F5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Fairness&amp;BiasRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-F5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Fairness&amp;BiasRequirements"/>
        <owl1:Description>The system shall log the fairness constraints applied during training or inference for traceability.</owl1:Description>
        <owl1:Name>Fairness Constraint Logging</owl1:Name>
        <owl1:Source>General best practice for audit.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-G1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-G1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Governance&amp;Compliance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-G1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Governance&amp;Compliance"/>
        <owl1:Description>The system shall maintain an inventory of all AI assets (datasets, models, pipelines, embeddings).</owl1:Description>
        <owl1:Name>AI Asset Inventory</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause 4.4 (AI system inventory).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-G2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-G2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Governance&amp;Compliance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-G2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Governance&amp;Compliance"/>
        <owl1:Description>The system shall automatically detect when a model is used outside its intended use case (based on metadata).</owl1:Description>
        <owl1:Name>Intended Use Detection</owl1:Name>
        <owl1:Source>NIST AI 100-1, MAP function (context detection).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-G3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-G3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Governance&amp;Compliance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-G3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Governance&amp;Compliance"/>
        <owl1:Description>The system shall support impact assessment workflows (e.g., privacy impact, ethics review) before model deployment.</owl1:Description>
        <owl1:Name>Impact Assessment Workflow</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause 5.4 (AI impact assessment).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-G4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-G4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Governance&amp;Compliance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-G4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Governance&amp;Compliance"/>
        <owl1:Description>The system shall record review and approval decisions for each model version, including approver identity and timestamp.</owl1:Description>
        <owl1:Name>Approval Recording</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause 7.5 (Documented information).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-G5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-G5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/Governance&amp;Compliance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-G5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/Governance&amp;Compliance"/>
        <owl1:Description>The system shall generate model fact sheets (model cards) in standardized formats.</owl1:Description>
        <owl1:Name>Standardized Model Cards</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.8 (Documentation).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-G7-1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-G7-1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/CodeOfConduct"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-G7-1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/CodeOfConduct"/>
        <owl1:Description>The system shall identify, evaluate, and mitigate risks across the entire AI lifecycle — including prior to and throughout deployment — using diverse internal and independent external testing measures such as red-teaming.</owl1:Description>
        <owl1:Name>Risk Identification and Mitigation across Lifecycle</owl1:Name>
        <owl1:Source>G7 Hiroshima Process International Code of Conduct, Action 1</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-G7-2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-G7-2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/CodeOfConduct"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-G7-2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/CodeOfConduct"/>
        <owl1:Description>The system shall identify and mitigate vulnerabilities, incidents, and patterns of misuse after deployment, including placement on the market, with documented and regularly updated technical documentation.</owl1:Description>
        <owl1:Name>Post‑deployment Vulnerability Monitoring</owl1:Name>
        <owl1:Source>G7 Hiroshima Process International Code of Conduct, Action 2</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-G7-3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-G7-3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/CodeOfConduct"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-G7-3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/CodeOfConduct"/>
        <owl1:Description>The system shall enable traceability of datasets, processes, and decisions made during system development to support testing, verification, and audit activities.</owl1:Description>
        <owl1:Name>Traceability of Datasets and Decisions</owl1:Name>
        <owl1:Source>G7 Hiroshima Process Code of Conduct — &quot;enable traceability, in relation to datasets, processes, and decisions made during system development&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-G7-4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-G7-4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/CodeOfConduct"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-G7-4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/CodeOfConduct"/>
        <owl1:Description>The system shall operate within internal AI governance structures and policies, including self‑assessment mechanisms, to facilitate a responsible and accountable approach to AI development and deployment.</owl1:Description>
        <owl1:Name>Internal AI Governance Structures</owl1:Name>
        <owl1:Source>G7 Hiroshima Process Code of Conduct — &quot;set up internal AI governance structures and policies, including self-assessment mechanisms&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-HAT1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-HAT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanAITeamingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-HAT1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanAITeamingRequirements"/>
        <owl1:Description>The system shall support six distinct human‑agent interaction modes that organize collaboration across a spectrum of AI autonomy, from full human control to full agent autonomy.</owl1:Description>
        <owl1:Name>Teaming Interaction Taxonomy</owl1:Name>
        <owl1:Source>ZHAW – Six‑mode taxonomy of human‑agent interaction (July 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-HAT2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-HAT2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanAITeamingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-HAT2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanAITeamingRequirements"/>
        <owl1:Description>The system shall adapt intelligently to situational and team requirements in a collaborative manner, demonstrating task involvement, information sharing, and strategizing rather than dominant or submissive behavior.</owl1:Description>
        <owl1:Name>Team Orientation and Adaptation</owl1:Name>
        <owl1:Source>PMC – Requirements for human‑AI teaming (Supplementary Table 1)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-HAT3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-HAT3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanAITeamingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-HAT3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanAITeamingRequirements"/>
        <owl1:Description>The system shall establish mutually shared mental models, directability, and observability as the “Basic Compact” of collaboration, enabling humans and AI to coordinate effectively on both goals and methods.</owl1:Description>
        <owl1:Name>Shared Mental Models</owl1:Name>
        <owl1:Source>Taylor &amp; Francis – Human‑Autonomy Teaming basic compact requirements</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-HAT4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-HAT4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanAITeamingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-HAT4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanAITeamingRequirements"/>
        <owl1:Description>The system shall clearly identify tasks that require human‑exclusive qualities: emotional intelligence, ethical judgment, real‑time improvisation, personal connection, team trust, and dialogue.</owl1:Description>
        <owl1:Name>Human‑exclusive Task Identification</owl1:Name>
        <owl1:Source>Prosci AI Integration Framework – “My Work” category (March 2026)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-HAT5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-HAT5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanAITeamingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-HAT5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanAITeamingRequirements"/>
        <owl1:Description>The system shall implement a hierarchical human‑centered AI (HCAI) framework with five categories of implementation methods, supported by joint cognitive system models, teaming situation awareness models, and shared social understanding models.</owl1:Description>
        <owl1:Name>Hierarchical HCAI Framework</owl1:Name>
        <owl1:Source>CAST – Hierarchical HCAI framework implementation methods</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-HO1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-HO1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanOversight"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-HO1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanOversight"/>
        <owl1:Description>The system shall enable human override of AI decisions in high-risk workflows.</owl1:Description>
        <owl1:Name>Human Override</owl1:Name>
        <owl1:Source>EU AI Act, Article 14 (Human oversight).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-HO2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-HO2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanOversight"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-HO2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanOversight"/>
        <owl1:Description>The system shall log all human overrides including who, when, what decision was overridden, and reason.</owl1:Description>
        <owl1:Name>Override Logging</owl1:Name>
        <owl1:Source>EU AI Act, Article 12 (Record-keeping).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-HO3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-HO3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanOversight"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-HO3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanOversight"/>
        <owl1:Description>The system shall provide interpretable outputs to enable effective human review.</owl1:Description>
        <owl1:Name>Interpretable Outputs</owl1:Name>
        <owl1:Source>EU AI Act, Article 13 (Transparency).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-HO4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-HO4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanOversight"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-HO4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/HumanOversight"/>
        <owl1:Description>The system shall notify human supervisors of critical failures or anomalies requiring intervention.</owl1:Description>
        <owl1:Name>Supervisor Notification</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure Maintenance Phase.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-I1.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-I1.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-I1.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
        <owl1:Description>The system shall generate outputs using deployed models from input data.</owl1:Description>
        <owl1:Name>Output Generation</owl1:Name>
        <owl1:Source>EU AI Act, Article 3(1) (Definition of an AI system).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-I1.2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-I1.2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-I1.2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
        <owl1:Description>The system shall support deterministic and probabilistic inference modes.</owl1:Description>
        <owl1:Name>Deterministic/Probabilistic Inference</owl1:Name>
        <owl1:Source>General best practice for AI inference.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-I2.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-I2.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-I2.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
        <owl1:Description>The system shall meet defined latency thresholds per use case class (real-time, near-real-time, batch).</owl1:Description>
        <owl1:Name>Latency Control</owl1:Name>
        <owl1:Source>General best practice for AI performance.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-I3.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-I3.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-I3.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
        <owl1:Description>The system shall provide confidence scores or uncertainty estimates when applicable.</owl1:Description>
        <owl1:Name>Confidence Scoring</owl1:Name>
        <owl1:Source>NIST AI 100-1, Valid and Reliable characteristic.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-I4.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-I4.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-I4.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
        <owl1:Description>The system shall provide explanations for outputs where required by domain constraints.</owl1:Description>
        <owl1:Name>Explainability</owl1:Name>
        <owl1:Source>EU AI Act, Article 13 (Transparency and provision of information to users).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-I5.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-I5.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-I5.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
        <owl1:Description>The system shall define and execute fallback logic when confidence is low or inference fails.</owl1:Description>
        <owl1:Name>Fallback Logic</owl1:Name>
        <owl1:Source>General best practice for robustness.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-I6.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-I6.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-I6.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
        <owl1:Description>The system shall support idempotent requests for retry-safe operations.</owl1:Description>
        <owl1:Name>Idempotent Requests</owl1:Name>
        <owl1:Source>General best practice for API design.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-I7.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-I7.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-I7.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Inference&amp;DecisionsRequirements"/>
        <owl1:Description>The system shall store batch inference results for audit and reanalysis.</owl1:Description>
        <owl1:Name>Batch Result Persistence</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.8 (Documentation).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-INF1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-INF1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdvancedInferenceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-INF1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdvancedInferenceRequirements"/>
        <owl1:Description>The system shall support conditional inference – skip model execution for trivial or high-confidence cached cases.</owl1:Description>
        <owl1:Name>Conditional Inference</owl1:Name>
        <owl1:Source>General best practice for performance optimization.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-INF2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-INF2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdvancedInferenceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-INF2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdvancedInferenceRequirements"/>
        <owl1:Description>The system shall allow speculative inference (run multiple candidate outputs in parallel and select best).</owl1:Description>
        <owl1:Name>Speculative Inference</owl1:Name>
        <owl1:Source>General best practice for advanced inference.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-INF3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-INF3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdvancedInferenceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-INF3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdvancedInferenceRequirements"/>
        <owl1:Description>The system shall support inference with memory (cross-request context retention for conversational AI).</owl1:Description>
        <owl1:Name>Context-aware Inference</owl1:Name>
        <owl1:Source>General best practice for conversational AI.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-INF4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-INF4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdvancedInferenceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-INF4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdvancedInferenceRequirements"/>
        <owl1:Description>The system shall implement timeout and circuit breaker patterns for downstream model APIs.</owl1:Description>
        <owl1:Name>Timeout &amp; Circuit Breaker</owl1:Name>
        <owl1:Source>General best practice for resilience.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-INF5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-INF5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdvancedInferenceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-INF5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#AdvancedInferenceRequirements"/>
        <owl1:Description>The system shall support inference batching (dynamic batching of real-time requests to improve throughput).</owl1:Description>
        <owl1:Name>Dynamic Batching</owl1:Name>
        <owl1:Source>General best practice for performance optimization.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-IR1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-IR1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponseRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-IR1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponseRequirements"/>
        <owl1:Description>The system shall automatically detect and report serious AI incidents within regulatory timeframes (e.g., 72 hours).</owl1:Description>
        <owl1:Name>Regulatory Incident Reporting</owl1:Name>
        <owl1:Source>EU AI Act, Article 55 (Incident reporting).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-IR2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-IR2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponseRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-IR2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponseRequirements"/>
        <owl1:Description>The system shall record incident root cause analysis including the model version, input, output, and system state.</owl1:Description>
        <owl1:Name>Root Cause Recording</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.6 (Risk management).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-IR3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-IR3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponseRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-IR3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponseRequirements"/>
        <owl1:Description>The system shall flag behavioral anomalies (unexpected outputs, misuse patterns) for review.</owl1:Description>
        <owl1:Name>Behavioral Anomaly Flagging</owl1:Name>
        <owl1:Source>NIST AI RMF (MEASURE function).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-IR4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-IR4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponseRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-IR4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#IncidentResponseRequirements"/>
        <owl1:Description>The system shall support post-incident model quarantine – block inference without deletion.</owl1:Description>
        <owl1:Name>Post-incident Quarantine</owl1:Name>
        <owl1:Source>General best practice for incident response.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-L1.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-L1.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Learning&amp;AdaptationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-L1.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Learning&amp;AdaptationRequirements"/>
        <owl1:Description>The system shall support periodic retraining or incremental learning based on new data.</owl1:Description>
        <owl1:Name>Periodic Retraining</owl1:Name>
        <owl1:Source>General best practice for MLOps.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-L2.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-L2.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Learning&amp;AdaptationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-L2.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Learning&amp;AdaptationRequirements"/>
        <owl1:Description>The system shall detect data drift, concept drift, and performance degradation.</owl1:Description>
        <owl1:Name>Drift Detection</owl1:Name>
        <owl1:Source>NIST AI 100-1, Manage function (Risk Treatment).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-L3.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-L3.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Learning&amp;AdaptationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-L3.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Learning&amp;AdaptationRequirements"/>
        <owl1:Description>The system shall adjust model behavior based on validated feedback or updated data distributions.</owl1:Description>
        <owl1:Name>Adaptive Behavior</owl1:Name>
        <owl1:Source>General best practice for adaptive systems.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-L4.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-L4.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Learning&amp;AdaptationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-L4.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Learning&amp;AdaptationRequirements"/>
        <owl1:Description>The system shall require human approval before automated retraining deployment.</owl1:Description>
        <owl1:Name>Human-approved Retraining</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure Maintenance Phase.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-L5.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-L5.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Learning&amp;AdaptationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-L5.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Learning&amp;AdaptationRequirements"/>
        <owl1:Description>The system shall auto-rollback if retrained model fails performance thresholds.</owl1:Description>
        <owl1:Name>Auto-rollback on Failure</owl1:Name>
        <owl1:Source>General best practice for MLOps.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-LB1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-LB1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataLabelingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-LB1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataLabelingRequirements"/>
        <owl1:Description>The system shall support active learning workflows – select most informative samples for human labeling.</owl1:Description>
        <owl1:Name>Active Learning</owl1:Name>
        <owl1:Source>General best practice for data labeling.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-LB2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-LB2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataLabelingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-LB2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataLabelingRequirements"/>
        <owl1:Description>The system shall provide label consistency checks (e.g., Cohen&apos;s kappa between annotators).</owl1:Description>
        <owl1:Name>Label Consistency Check</owl1:Name>
        <owl1:Source>General best practice for data labeling.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-LB3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-LB3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataLabelingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-LB3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataLabelingRequirements"/>
        <owl1:Description>The system shall allow label correction workflows – flag and relabel erroneous annotations without full retraining.</owl1:Description>
        <owl1:Name>Label Correction Workflow</owl1:Name>
        <owl1:Source>General best practice for data labeling.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-LB4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-LB4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataLabelingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-LB4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataLabelingRequirements"/>
        <owl1:Description>The system shall track label drift over time (change in labeling distribution).</owl1:Description>
        <owl1:Name>Label Drift Tracking</owl1:Name>
        <owl1:Source>General best practice for data labeling.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-LLM1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-LLM1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-LLM1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
        <owl1:Description>The system shall support retrieval-augmented generation (RAG) with pluggable vector databases.</owl1:Description>
        <owl1:Name>RAGSupport</owl1:Name>
        <owl1:Source>General best practice for LLMs.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-LLM2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-LLM2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-LLM2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
        <owl1:Description>The system shall allow grounding of LLM outputs against a knowledge base.</owl1:Description>
        <owl1:Name>Grounding</owl1:Name>
        <owl1:Source>General best practice for LLMs.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-LLM3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-LLM3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-LLM3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
        <owl1:Description>The system shall support structured output generation (JSON, XML, code) with schema validation.</owl1:Description>
        <owl1:Name>Structured Output Generation</owl1:Name>
        <owl1:Source>General best practice for LLMs.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-LLM4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-LLM4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-LLM4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
        <owl1:Description>The system shall implement token-level streaming for real-time user feedback.</owl1:Description>
        <owl1:Name>Token-level Streaming</owl1:Name>
        <owl1:Source>General best practice for LLMs.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-LLM5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-LLM5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-LLM5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
        <owl1:Description>The system shall provide citation and source attribution for generated content.</owl1:Description>
        <owl1:Name>Citation and Attribution</owl1:Name>
        <owl1:Source>General best practice for RAG.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-LLM6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-LLM6">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-LLM6"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
        <owl1:Description>The system shall support prompt versioning and management (templates, variables, tests).</owl1:Description>
        <owl1:Name>Prompt Versioning</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM07:2025 – System Prompt Leakage).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-LLM7 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-LLM7">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-LLM7"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#LLM&amp;GenAISpecificRequirements"/>
        <owl1:Description>The system shall allow few-shot example injection per request without retraining.</owl1:Description>
        <owl1:Name>Few-shot Injection</owl1:Name>
        <owl1:Source>General best practice for LLMs.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-MC1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-MC1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ModelDocumentationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-MC1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ModelDocumentationRequirements"/>
        <owl1:Description>The system shall generate model cards covering six core areas: model details, intended use, factors affecting performance, metrics and evaluation data, training data, and ethical considerations.</owl1:Description>
        <owl1:Name>Comprehensive Model Card</owl1:Name>
        <owl1:Source>Google Model Cards platform – VerifyWise AI Governance Library</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-MC2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-MC2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ModelDocumentationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-MC2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ModelDocumentationRequirements"/>
        <owl1:Description>The system shall ensure model documentation complies with ALCOA+ principles (Attributable, Legible, Contemporaneous, Original, Accurate, Complete, Consistent, Enduring, Available) for regulated environments.</owl1:Description>
        <owl1:Name>ALCOA+ compliant Documentation</owl1:Name>
        <owl1:Source>CAIDRA‑compliant Model Cards Standard</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-MC3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-MC3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ModelDocumentationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-MC3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ModelDocumentationRequirements"/>
        <owl1:Description>The system shall document 43 ethical requirements organized into four themes and twelve sub‑themes representing ethical principles for AI model transparency.</owl1:Description>
        <owl1:Name>Ethical Requirements Taxonomy</owl1:Name>
        <owl1:Source>Model Cards Revisited – 43 ethical requirements taxonomy (July 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-MC4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-MC4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ModelDocumentationRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-MC4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ModelDocumentationRequirements"/>
        <owl1:Description>The system shall link model cards to associated data cards that document dataset provenance, composition, collection methods, and intended uses.</owl1:Description>
        <owl1:Name>Data Card Linkage</owl1:Name>
        <owl1:Source>Data Card (Pushkarna et al., 2022) – AI Product Card mandatory attributes</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-MI1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-MI1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#InformationTracklingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-MI1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#InformationTracklingRequirements"/>
        <owl1:Description>The system shall evaluate and rate output factuality against grounded knowledge sources when applicable.</owl1:Description>
        <owl1:Name>Factuality Rating</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM09:2025 – Misinformation).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-MI2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-MI2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#InformationTracklingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-MI2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#InformationTracklingRequirements"/>
        <owl1:Description>The system shall support source attribution and citation for all generated factual claims.</owl1:Description>
        <owl1:Name>Source Attribution</owl1:Name>
        <owl1:Source>NIST AI RMF (GOVERN 5.1).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-MI3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-MI3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#InformationTracklingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-MI3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#InformationTracklingRequirements"/>
        <owl1:Description>The system shall flag potentially hallucinated content with confidence scores for human review.</owl1:Description>
        <owl1:Name>Hallucination Flagging</owl1:Name>
        <owl1:Source>NIST AI RMF (Valid and Reliable).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-MI4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-MI4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#InformationTracklingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-MI4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#InformationTracklingRequirements"/>
        <owl1:Description>The system shall implement verification guardrails for high-stakes claims (legal, medical, financial).</owl1:Description>
        <owl1:Name>High-stakes Guardrails</owl1:Name>
        <owl1:Source>Singapore AI Verify Framework.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-O1.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-O1.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MonitoringRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-O1.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MonitoringRequirements"/>
        <owl1:Description>The system shall track accuracy, latency, throughput, and resource usage.</owl1:Description>
        <owl1:Name>Performance Tracking</owl1:Name>
        <owl1:Source>NIST AI 100-1, Measure function (metrics).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-O2.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-O2.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MonitoringRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-O2.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MonitoringRequirements"/>
        <owl1:Description>The system shall detect anomalous outputs and unsafe behavior patterns.</owl1:Description>
        <owl1:Name>Anomaly Detection</owl1:Name>
        <owl1:Source>NIST AI 100-1, Safe characteristic.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-O3.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-O3.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MonitoringRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-O3.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MonitoringRequirements"/>
        <owl1:Description>The system shall log inputs, outputs, decisions, and system states in structured format.</owl1:Description>
        <owl1:Name>Structured Logging</owl1:Name>
        <owl1:Source>EU AI Act, Article 12 (Record-keeping).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-O4.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-O4.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MonitoringRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-O4.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MonitoringRequirements"/>
        <owl1:Description>The system shall allow reconstruction of decisions for audit purposes.</owl1:Description>
        <owl1:Name>Decision Auditability</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.8 (Documentation).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-O5.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-O5.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MonitoringRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-O5.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MonitoringRequirements"/>
        <owl1:Description>The system shall define and trigger alerts based on metric thresholds (drift, performance drop, anomaly spike).</owl1:Description>
        <owl1:Name>Threshold-based Alerting</owl1:Name>
        <owl1:Source>General best practice for monitoring.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-O6.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-O6.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MonitoringRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-O6.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#MonitoringRequirements"/>
        <owl1:Description>The system shall provide real-time dashboards for all monitored metrics.</owl1:Description>
        <owl1:Name>Real-time Dashboards</owl1:Name>
        <owl1:Source>General best practice for monitoring.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-OBS1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-OBS1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ObservabilityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-OBS1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ObservabilityRequirements"/>
        <owl1:Description>The system shall detect and respond to explanation drift in production environments using three indicators: (a) statistical distributional shifts in input space, (b) deviations in explanation‑specific embeddings, and (c) anomalies in human‑provided feedback loops.</owl1:Description>
        <owl1:Name>Explanation Drift Detection</owl1:Name>
        <owl1:Source>Post‑Deployment XAI Monitoring specification (May 2026)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-OBS2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-OBS2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ObservabilityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-OBS2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ObservabilityRequirements"/>
        <owl1:Description>The system shall monitor prompt drift, model drift, and evaluation‑score drift separately, using different detection methodologies for each drift type, including schema evolution drift detection.</owl1:Description>
        <owl1:Name>Multi‑dimensional Drift Monitoring</owl1:Name>
        <owl1:Source>FutureAGI – LLM Drift Taxonomy (Jan 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-OBS3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-OBS3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ObservabilityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-OBS3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ObservabilityRequirements"/>
        <owl1:Description>The system shall attach online evaluation scores to individual request spans and trigger drift alerts based on rolling means per rubric, preventing drift from remaining invisible until users complain.</owl1:Description>
        <owl1:Name>Span‑attached Online Evaluation</owl1:Name>
        <owl1:Source>Production LLM Monitoring Checklist 2026 – mandatory monitoring items</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-OBS4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-OBS4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ObservabilityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-OBS4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ObservabilityRequirements"/>
        <owl1:Description>The system shall analyze agent reasoning traces to identify where decisions degraded, build an alerting strategy for gradual drift detection (not just outages), and debug agentic failures using reasoning traces.</owl1:Description>
        <owl1:Name>Agent Reasoning Trace Analysis</owl1:Name>
        <owl1:Source>Ascend.io – Observability for agentic AI (April 2026)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-OBS5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-OBS5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/ObservabilityRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-OBS5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/ObservabilityRequirements"/>
        <owl1:Description>The system shall maintain a rolling 7‑day mean and standard deviation per evaluator and compare current distributions to the last “green window,” alerting when statistical thresholds are exceeded.</owl1:Description>
        <owl1:Name>Evaluation‑score Time‑series Monitoring</owl1:Name>
        <owl1:Source>FutureAGI – Evaluating GenAI in Production 2026 framework</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-OS1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-OS1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#OutputSafetyRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-OS1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#OutputSafetyRequirements"/>
        <owl1:Description>The system shall sanitize outputs before rendering to prevent XSS or injection attacks.</owl1:Description>
        <owl1:Name>Output Sanitization</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM05:2025 – Improper Output Handling).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-OS2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-OS2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#OutputSafetyRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-OS2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#OutputSafetyRequirements"/>
        <owl1:Description>The system shall filter prohibited content based on configurable safety policies.</owl1:Description>
        <owl1:Name>Prohibited Content Filtering</owl1:Name>
        <owl1:Source>EU AI Act (Prohibited AI practices).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-OS3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-OS3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#OutputSafetyRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-OS3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#OutputSafetyRequirements"/>
        <owl1:Description>The system shall escape or reject outputs containing executable code in non-code contexts.</owl1:Description>
        <owl1:Name>Executable Code Blocking</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM05:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-OS4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-OS4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#OutputSafetyRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-OS4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#OutputSafetyRequirements"/>
        <owl1:Description>The system shall redact sensitive information from outputs before delivery to users.</owl1:Description>
        <owl1:Name>Sensitive Information Redaction</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM02:2025 – Sensitive Information Disclosure).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-PH1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-PH1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#PromptHandlingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-PH1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#PromptHandlingRequirements"/>
        <owl1:Description>The system shall prevent direct disclosure of system prompts through user prompt manipulation.</owl1:Description>
        <owl1:Name>Direct Disclosure Prevention</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM07:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-PH2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-PH2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#PromptHandlingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-PH2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#PromptHandlingRequirements"/>
        <owl1:Description>The system shall redact system prompt metadata from response outputs and logs.</owl1:Description>
        <owl1:Name>Metadata Redaction</owl1:Name>
        <owl1:Source>General best practice for data protection.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-PH3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-PH3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#PromptHandlingRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-PH3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#PromptHandlingRequirements"/>
        <owl1:Description>The system shall support system prompt encryption at rest and in transit.</owl1:Description>
        <owl1:Name>Prompt Encryption</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SC-13 (Cryptographic Protection).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-PMM1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-PMM1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/PostMarketMonitoringRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-PMM1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/PostMarketMonitoringRequirements"/>
        <owl1:Description>The system shall support reporting serious incidents involving high‑risk AI systems to the competent national market surveillance authority without delay, with reporting timelines of 2‑15 days depending on incident severity and type.</owl1:Description>
        <owl1:Name>AI Incident Reporting</owl1:Name>
        <owl1:Source>EU AI Act Article 73 (effective August 2026)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-PMM2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-PMM2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/PostMarketMonitoringRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-PMM2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/PostMarketMonitoringRequirements"/>
        <owl1:Description>The system shall continuously monitor high‑risk AI systems for emerging risks and take corrective actions as needed to maintain compliance throughout the system’s lifecycle, collecting and analyzing performance data in a proportionate manner to the nature of AI technologies and risks.</owl1:Description>
        <owl1:Name>Continuous Risk Monitoring</owl1:Name>
        <owl1:Source>EU AI Act Article 72 (post‑market monitoring plan)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-PMM3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-PMM3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/PostMarketMonitoringRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-PMM3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/PostMarketMonitoringRequirements"/>
        <owl1:Description>The system shall implement a tiered reporting system for serious incidents with different response procedures based on incident severity: two days for most severe incidents, up to 15 days for less urgent cases.</owl1:Description>
        <owl1:Name>Tiered Incident Response</owl1:Name>
        <owl1:Source>European Commission – Tiered AI incident reporting guidelines (Sept 2025)</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-PMM4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-PMM4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/PostMarketMonitoringRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-PMM4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/PostMarketMonitoringRequirements"/>
        <owl1:Description>The system shall support reporting to multiple market surveillance authorities when an incident occurs or impacts users in multiple Member States, with mechanisms for tracking and coordinating responses across jurisdictions.</owl1:Description>
        <owl1:Name>Multi‑jurisdictional Notification</owl1:Name>
        <owl1:Source>EU AI Act – Cross‑border serious incident reporting obligations</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-SAFE1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-SAFE1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SafeFrameworkRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-SAFE1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SafeFrameworkRequirements"/>
        <owl1:Description>The system shall evaluate the AI‑specific attack surface introduced through inherent dependency on data and learning processes, including adversarial inputs, poisoning, and exploitation of automated decision‑making.</owl1:Description>
        <owl1:Name>AI Attack Surface Evaluation</owl1:Name>
        <owl1:Source>MITRE SAFE‑AI Framework — &quot;AI contributes to the attack surface through its inherent dependency on data and corresponding learning processes&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-SAFE2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-SAFE2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SafeFrameworkRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-SAFE2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SafeFrameworkRequirements"/>
        <owl1:Description>The system shall assess and mitigate risks from third-party libraries, frameworks, and pre-trained models that may contain hidden vulnerabilities or malicious code, especially given that most organizations acquire models from open source or proprietary sources with limited risk determination methods.</owl1:Description>
        <owl1:Name>AI Supply Chain Risk Management</owl1:Name>
        <owl1:Source>MITRE SAFE‑AI Framework — &quot;AI systems often rely on third-party libraries, frameworks, and pre-trained models, which may contain hidden vulnerabilities or malicious code&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-SAFE3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-SAFE3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SafeFrameworkRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-SAFE3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SafeFrameworkRequirements"/>
        <owl1:Description>The system shall support assessment of hybrid controls that address both traditional cybersecurity concerns and AI‑specific threats, integrating MITRE ATLAS mapping for comprehensive security evaluation.</owl1:Description>
        <owl1:Name>Hybrid Control Assessment</owl1:Name>
        <owl1:Source>MITRE SAFE‑AI Framework — Appendix A: &quot;ATLAS Framework with SAFE-AI Mapping&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-SAFE4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-SAFE4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SafeFrameworkRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-SAFE4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SafeFrameworkRequirements"/>
        <owl1:Description>The system shall implement controls to prevent exploitation of model biases that attackers could manipulate to cause unintended or harmful system behaviors.</owl1:Description>
        <owl1:Name>Model Bias Exploitation Prevention</owl1:Name>
        <owl1:Source>MITRE SAFE‑AI Framework — &quot;threats include adversarial inputs, poisoning, exploiting automated decision-making, exploiting model biases, and exposure of sensitive information&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-SAFE5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-SAFE5">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/SafeFrameworkRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-SAFE5"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/SafeFrameworkRequirements"/>
        <owl1:Description>The system shall apply enhanced security controls for AI systems classified as high‑value assets, using the HVA Overlay approach defined in the SAFE‑AI framework to prioritize protection for critical AI components.</owl1:Description>
        <owl1:Name>High‑value Asset Overlay for AI</owl1:Name>
        <owl1:Source>MITRE SAFE‑AI Framework — Appendix F: &quot;High Value Asset (HVA) Overlay&quot;</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-SD1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-SD1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DeploymentRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-SD1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DeploymentRequirements"/>
        <owl1:Description>The system shall validate deployment baselines against secure configuration requirements before production deployment.</owl1:Description>
        <owl1:Name>Pre-deployment Validation</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure Deployment Phase.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-SD2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-SD2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DeploymentRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-SD2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DeploymentRequirements"/>
        <owl1:Description>The system shall enforce staged rollouts (canary, blue-green) with automated rollback on anomaly detection.</owl1:Description>
        <owl1:Name>Staged Rollouts</owl1:Name>
        <owl1:Source>NIST SP 800-218A, PO.3 (Deploy).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-SD3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-SD3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DeploymentRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-SD3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DeploymentRequirements"/>
        <owl1:Description>The system shall compare pre-deployment performance to current production model before full rollout.</owl1:Description>
        <owl1:Name>Performance Comparison</owl1:Name>
        <owl1:Source>General best practice for deployment.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-SD4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-SD4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DeploymentRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-SD4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DeploymentRequirements"/>
        <owl1:Description>The system shall reject deployment if critical security or performance thresholds are not met.</owl1:Description>
        <owl1:Name>Threshold-based Rejection</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure Deployment Phase.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-SP1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-SP1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemPromptManagement"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-SP1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemPromptManagement"/>
        <owl1:Description>The system shall detect and prevent system prompt leakage through user inputs or retrieved context.</owl1:Description>
        <owl1:Name>Leakage Prevention</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM07:2025 – System Prompt Leakage).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-SP2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-SP2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemPromptManagement"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-SP2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemPromptManagement"/>
        <owl1:Description>The system shall support version-controlled, environment-specific system prompts with rollback capability.</owl1:Description>
        <owl1:Name>Version-controlled Prompts</owl1:Name>
        <owl1:Source>General best practice for prompt management.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-SP3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-SP3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemPromptManagement"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-SP3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemPromptManagement"/>
        <owl1:Description>The system shall enforce least-privilege prompting – system prompts shall not contain secrets or hardcoded credentials.</owl1:Description>
        <owl1:Name>Least-privilege Prompting</owl1:Name>
        <owl1:Source>Google Secure AI Framework.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-SP4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-SP4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemPromptManagement"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-SP4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SystemPromptManagement"/>
        <owl1:Description>The system shall detect indirect prompt injection in retrieved or external content and isolate accordingly.</owl1:Description>
        <owl1:Name>Indirect Injection Isolation</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM01:2025 – Prompt Injection).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-TPA1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-TPA1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-TPA1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRequirements"/>
        <owl1:Description>The system shall vet all third-party models against a security checklist before import.</owl1:Description>
        <owl1:Name>Security Checklist Vetting</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM03:2025 – Supply Chain Vulnerabilities).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-TPA2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-TPA2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-TPA2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRequirements"/>
        <owl1:Description>The system shall scan third-party models for known backdoors before deployment.</owl1:Description>
        <owl1:Name>Backdoor Scanning</owl1:Name>
        <owl1:Source>MITRE ATLAS Supply Chain Technique.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-TPA3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-TPA3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-TPA3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRequirements"/>
        <owl1:Description>The system shall document and maintain SBOMs for AI systems (Software/AI Bill of Materials).</owl1:Description>
        <owl1:Name>SBOM Maintenance</owl1:Name>
        <owl1:Source>NIST SP 800-218A.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-TPA4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-TPA4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-TPA4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Third-PartyAIRequirements"/>
        <owl1:Description>The system shall enforce runtime sandboxing for all third-party model execution.</owl1:Description>
        <owl1:Name>Runtime Sandboxing</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure Deployment Phase.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-U1.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-U1.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#HumanInteractionRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-U1.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#HumanInteractionRequirements"/>
        <owl1:Description>The system shall support multiple input modalities (text, image, audio, structured data).</owl1:Description>
        <owl1:Name>Multi-modal Input</owl1:Name>
        <owl1:Source>General best practice for AI systems.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-U2.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-U2.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#HumanInteractionRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-U2.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#HumanInteractionRequirements"/>
        <owl1:Description>The system shall present outputs in human-readable and machine-readable formats.</owl1:Description>
        <owl1:Name>Human/machine-readable Output</owl1:Name>
        <owl1:Source>EU AI Act, Article 13 (Transparency).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-U3.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-U3.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#HumanInteractionRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-U3.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#HumanInteractionRequirements"/>
        <owl1:Description>The system shall collect user feedback for continuous learning and monitoring.</owl1:Description>
        <owl1:Name>Feedback Collection</owl1:Name>
        <owl1:Source>NIST AI RMF, MAP function (Feedback Loop).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-U4.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-U4.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#HumanInteractionRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-U4.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#HumanInteractionRequirements"/>
        <owl1:Description>The system shall allow human intervention to modify or reject AI outputs in critical workflows.</owl1:Description>
        <owl1:Name>Human Override</owl1:Name>
        <owl1:Source>EU AI Act, Article 14 (Human oversight).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-U5.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-U5.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#HumanInteractionRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-U5.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#HumanInteractionRequirements"/>
        <owl1:Description>The system shall store user-level preferences for explanation detail, confidence display, etc.</owl1:Description>
        <owl1:Name>User Preference Storage</owl1:Name>
        <owl1:Source>General best practice for personalization.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR-U6.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR-U6.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#HumanInteractionRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR-U6.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#HumanInteractionRequirements"/>
        <owl1:Description>The system shall support output localization where required.</owl1:Description>
        <owl1:Name>Output Localization</owl1:Name>
        <owl1:Source>General best practice for multilingual systems.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR1-CG1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR1-CG1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ComputeGovernanceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR1-CG1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ComputeGovernanceRequirements"/>
        <owl1:Description>The system shall track compute resource consumption per user, per session, and per model.</owl1:Description>
        <owl1:Name>Resource Consumption Tracking</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM10:2025 – Unbounded Consumption).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR1-CG2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR1-CG2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ComputeGovernanceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR1-CG2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ComputeGovernanceRequirements"/>
        <owl1:Description>The system shall enforce per-request compute limits (e.g., max tokens, FLOPs budget) to prevent resource exhaustion.</owl1:Description>
        <owl1:Name>Per-request Compute Limits</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM10:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR1-CG3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR1-CG3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ComputeGovernanceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR1-CG3"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ComputeGovernanceRequirements"/>
        <owl1:Description>The system shall monitor and alert on anomalous compute consumption patterns.</owl1:Description>
        <owl1:Name>Anomalous Consumption Alerting</owl1:Name>
        <owl1:Source>OWASP Top 10 for LLMs (LLM10:2025).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/FR1-CG4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/FR1-CG4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ComputeGovernanceRequirements"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/FR1-CG4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ComputeGovernanceRequirements"/>
