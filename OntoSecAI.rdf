        <owl1:Description>The system shall support ingestion of structured, semi-structured, and unstructured data.</owl1:Description>
        <owl1:Name>Multi-format Ingestion</owl1:Name>
        <owl1:Source>Derived from common enterprise data pipeline requirements for AI systems.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D1.2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D1.2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataManagementRequirements"/>
        <owl1:Description>The system shall validate input data against schema rules where applicable.</owl1:Description>
        <owl1:Name>Schema Validation</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control SI-10 (Information Input Validation).</owl1:Source>
    </owl:NamedIndividual>
