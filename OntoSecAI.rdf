        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#VulnerabilityManagement"/>
        <owl1:Description>The system shall continuously scan AI dependencies for known vulnerabilities (CVEs).</owl1:Description>
        <owl1:Name>Continuous Dcanning</owl1:Name>
        <owl1:Source>NIST SP 800-53, Control RA-5 (Vulnerability Scanning).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/SR2-VUL2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/SR2-VUL2">
