    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D1.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D1.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataManagementRequirements"/>
        <owl1:Description>The system shall support ingestion of structured, semi-structured, and unstructured data.</owl1:Description>
        <owl1:Name>Multi-format Ingestion</owl1:Name>
        <owl1:Source>Derived from common enterprise data pipeline requirements for AI systems.</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D1.1"/>
