    <rdf:Description>
        <Name>Data Quality depends on Data Management</Name>
        <Purpose>Identifies which data quality NFRs in the system depend on data management requirements.</Purpose>
        <RuleID>R‑DEP‑007</RuleID>
        <Condition:Inference>If a NonFunctionalRequirements has category &quot;Completeness&quot; and depends on a FunctionalRequirements with category &quot;DataManagementRequirements&quot;, then dependency is established.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/NonFunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#Completeness"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FunctionalRequirements"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                                <swrl:argument2 rdf:resource="urn:swrl:var#DataManagementRequirements"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/dependsOn"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/requirementDependsOn"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Name>Explainability depends on Transparency</Name>
        <Purpose>Identifies which explainability NFRs in the system depend on transparency requirements.</Purpose>
        <RuleID>R‑DEP‑010</RuleID>
        <Condition:Inference>If a NonFunctionalRequirements has category &quot;Explainability&quot; and depends on a FunctionalRequirements with category &quot;TransparencyRequirements&quot;, then dependency is established.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/NonFunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#Explainability"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FunctionalRequirements"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                                <swrl:argument2 rdf:resource="urn:swrl:var#TransparencyRequirements"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/dependsOn"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/requirementDependsOn"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Name>Interoperability depends on Standards</Name>
        <Purpose>Identifies which interoperability NFRs in the system depend on standards compliance.</Purpose>
        <RuleID>R‑DEP‑016</RuleID>
        <Condition:Inference>If a NonFunctionalRequirements has category &quot;Interoperability&quot; and depends on a FunctionalRequirements with category &quot;StandardCompliance&quot;, then dependency is established.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/NonFunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#Interoperability"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FunctionalRequirements"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                                <swrl:argument2 rdf:resource="urn:swrl:var#StandardCompliance"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/dependsOn"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/requirementDependsOn"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Name>Portability depends on Containerization</Name>
        <Purpose>Identifies which portability NFRs in the system depend on containerization.</Purpose>
        <RuleID>R‑DEP‑017</RuleID>
        <Condition:Inference>If a NonFunctionalRequirements has category &quot;Portability&quot; and depends on a FunctionalRequirements with category &quot;Containerization&quot;, then dependency is established.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/NonFunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#Portability"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FunctionalRequirements"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                                <swrl:argument2 rdf:resource="urn:swrl:var#Containerization"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/dependsOn"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/requirementDependsOn"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Name>Recoverability depends on Backup</Name>
        <Purpose>Identifies which recoverability NFRs in the system depend on backup capabilities.</Purpose>
        <RuleID>R‑DEP‑015</RuleID>
        <Condition:Inference>If a NonFunctionalRequirements has category &quot;Recoverability&quot; and depends on a FunctionalRequirements with category &quot;Backup&quot;, then dependency is established.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/NonFunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#Recoverability"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FunctionalRequirements"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                                <swrl:argument2 rdf:resource="urn:swrl:var#Backup"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/dependsOn"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/requirementDependsOn"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Name>Human Oversight depends on Explainability</Name>
        <Purpose>Identifies which human oversight requirements in the system depend on explainability NFRs.</Purpose>
        <RuleID>R‑DEP‑025</RuleID>
        <Condition:Inference>If a FunctionalRequirements has category &quot;HumanInteractionRequirements&quot; and depends on a NonFunctionalRequirements with category &quot;Explainability&quot;, then dependency is established.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#HumanInteractionRequirements"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/NonFunctionalRequirements"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                                <swrl:argument2 rdf:resource="urn:swrl:var#Explainability"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/dependsOn"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/requirementDependsOn"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Name>Bias Monitoring depends on Fairness</Name>
        <Purpose>Identifies which bias monitoring requirements in the system depend on fairness NFRs.</Purpose>
        <RuleID>R‑DEP‑026</RuleID>
        <Condition:Inference>If a FunctionalRequirements has category &quot;FairnessAndBiasRequirements&quot; and depends on a NonFunctionalRequirements with category &quot;Fairness&quot;, then dependency is established.</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#Fairness&amp;BiasRequirements"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/NonFunctionalRequirements"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r2"/>
                                                <swrl:argument2 rdf:resource="urn:swrl:var#Fairness"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/dependsOn"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/requirementDependsOn"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r1"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#r2"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Purpose>Identifies the system&apos;s usability NFRs by checking if they are defined by an End-User stakeholder.</Purpose>
        <RuleID>R‑MAP‑STK‑003</RuleID>
        <owl1:Name>EndUser Stakeholder Classification</owl1:Name>
        <Condition:Inference>If a Stakeholder has role &quot;EndUser&quot; and defines a Requirement with category Usability, then the requirement is classified as a NonFunctionalRequirement</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasRole"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#EndUser"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/define"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#r"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#Usability"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/NonFunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Purpose>Identifies the system&apos;s cost governance and end-of-life requirements by checking if they are defined by a Product Owner.</Purpose>
        <RuleID>R‑MAP‑STK‑011</RuleID>
        <owl1:Name>ProductOwner Stakeholder Classification</owl1:Name>
        <Condition:Inference>If a Stakeholder has role &quot;ProductOwner&quot; and defines a Requirement with category AICostGovernanceRequirements or SystemEndOffLife, then the requirement is classified as a FunctionalRequirement</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasRole"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#ProductOwner"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/define"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#r"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#&apos;AICostGovernanceRequirements;%20?SystemEndOffLife&apos;"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Purpose>Identifies the system&apos;s audit and compliance security requirements by checking if they are defined by an Auditor.</Purpose>
        <Purpose>If a Stakeholder has role &quot;Auditor&quot; and defines a Requirement with category AuditAndCompliance or Auditability, then the requirement is classified as a SecurityRequirement</Purpose>
        <RuleID>R‑MAP‑STK‑009</RuleID>
        <owl1:Name>Auditor Stakeholder Classification</owl1:Name>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasRole"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#Auditor"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/define"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#r"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#&apos;AuditAndCompliance;?Auditability&apos;"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#SecurityRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Purpose>Identifies the system&apos;s data management requirements by checking if they are defined by a Data Provider stakeholder.</Purpose>
        <RuleID>R‑MAP‑STK‑005</RuleID>
        <owl1:Name>DataProvider Stakeholder Classification</owl1:Name>
        <Condition:Inference>If a Stakeholder has role &quot;DataProvider&quot; and defines a Requirement with category DataManagementRequirements or TrainingDataQualityRequirements, then the requirement is classified as a FunctionalRequirement</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasRole"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#DataProvider"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/define"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#r"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#&apos;DataManagementRequirements;%20?TrainingDataQualityRequirements&apos;"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Purpose>Identifies the system&apos;s functional requirements by checking if they are technical requirements defined by a Developer stakeholder.</Purpose>
        <RuleID>R‑MAP‑STK‑002</RuleID>
        <owl1:Name>Developer Stakeholder Classification</owl1:Name>
        <Condition:Inference>If a Stakeholder has role &quot;Developer&quot; and defines a Requirement with category DataManagementRequirements or ModelLifecycleRequirements, then the requirement is classified as a FunctionalRequirement</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasRole"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#Developer"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/define"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#r"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#&apos;DataManagementRequirements;?ModelLifecycleRequirements&apos;"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Purpose>Identifies the system&apos;s ethical and fairness requirements by checking if they are defined by a Civil Society stakeholder.</Purpose>
        <RuleID>R‑MAP‑STK‑012</RuleID>
        <owl1:Name>CivilSociety Stakeholder Classification</owl1:Name>
        <Condition:Inference>If a Stakeholder has role &quot;CivilSociety&quot; and defines a Requirement with category EthicalDesignRequirements or FairnessAndBiasRequirements, then the requirement is classified as a NonFunctionalRequirement</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasRole"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#CivilSociety"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/define"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#r"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/Requirements"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/hasCategory"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#&apos;EthicalDesignRequirements;%20?FairnessAndBiasRequirements&apos;"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/NonFunctionalRequirements"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <Purpose>Identifies the system&apos;s organisational governance requirements by checking if they are defined by a Leader.</Purpose>
        <RuleID>R‑MAP‑STK‑007</RuleID>
        <owl1:Name>Leader Stakeholder Classification</owl1:Name>
        <Condition:Inference>If a Stakeholder has role &quot;Leader&quot; and defines a Requirement with category Governance or OrganisationalGovernance, then the requirement is classified as a NonFunctionalRequirement</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
