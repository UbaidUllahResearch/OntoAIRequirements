    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D4.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D4.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataManagementRequirements"/>
