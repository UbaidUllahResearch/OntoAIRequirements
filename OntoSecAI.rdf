    <rdf:Description>
        <Name>Data Quality Constrains Data</Name>
        <Purpose>Identifies which data assets in the system are constrained by data quality and governance NFRs.</Purpose>
        <RuleID>R‑MAP‑NFR‑ASSET‑005</RuleID>
        <Condition:Inference>If a NonFunctionalRequirements has category &quot;Completeness&quot; or &quot;TrainingDataGovernanceRequirements&quot; and constrains a DataResources, then the requirement constrains the data asset.</Condition:Inference>
