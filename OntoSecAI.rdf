        <owl1:Name>Graceful Model Retirement</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure End of Life Phase.</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-M6.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-M6.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelLifecycleRequirements"/>
        <owl1:Description>The system shall generate and maintain model cards documenting architecture, training data, intended use, and limitations.</owl1:Description>
        <owl1:Name>Model Card Generation</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.8 (Documentation).</owl1:Source>
    </owl:NamedIndividual>
