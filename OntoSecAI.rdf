    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-M5.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-M5.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#ModelLifecycleRequirements"/>
        <owl1:Description>The system shall support deprecation and removal of models without service disruption.</owl1:Description>
        <owl1:Name>Graceful Model Retirement</owl1:Name>
        <owl1:Source>ETSI EN 304 223, Secure End of Life Phase.</owl1:Source>
    </owl:NamedIndividual>
