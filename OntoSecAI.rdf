        <owl1:Source>ISO/IEC 42001:2023, Clause A.6 (Data Quality).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D2.1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D2.1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataManagementRequirements"/>
        <owl1:Description>The system shall record the origin, timestamp, and transformation history of all training and inference data.</owl1:Description>
        <owl1:Name>Data Provenance Recording</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.7 (Data Management and Provenance).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D2.1"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataManagementRequirements"/>
        <owl1:Description>The system shall record the origin, timestamp, and transformation history of all training and inference data.</owl1:Description>
        <owl1:Name>Data Provenance Recording</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause A.7 (Data Management and Provenance).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D2.2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D2.2">
        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataManagementRequirements"/>
        <owl1:Description>The system shall maintain traceability from output back to input data sources where feasible.</owl1:Description>
        <owl1:Name>Output-to-input Traceability</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause 8.3 (Traceability).</owl1:Source>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D2.2"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataManagementRequirements"/>
        <owl1:Description>The system shall maintain traceability from output back to input data sources where feasible.</owl1:Description>
        <owl1:Name>Output-to-input Traceability</owl1:Name>
        <owl1:Source>ISO/IEC 42001:2023, Clause 8.3 (Traceability).</owl1:Source>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2026/5/owl:#FR-D3.1 -->

