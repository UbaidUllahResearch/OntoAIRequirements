    <rdf:Description>
        <Purpose>Identifies the system&apos;s testability and reproducibility NFRs by checking if they are defined by a Tester.</Purpose>
        <RuleID>R‑MAP‑STK‑006</RuleID>
        <owl1:Name>Tester Stakeholder Classification</owl1:Name>
        <Condition:Inference>If a Stakeholder has role &quot;Tester&quot; and defines a Requirement with category TestingAndAssurance or Reproducibility, then the requirement is classified as a NonFunctionalRequirement</Condition:Inference>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#Stakeholders"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
