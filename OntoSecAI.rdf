        <rdf:type rdf:resource="http://www.semanticweb.org/hp/ontologies/2026/5/owl:#DataManagementRequirements"/>
        <owl1:Description>The system shall automatically purge data after defined retention period.</owl1:Description>
        <owl1:Name>Automated Data Purge</owl1:Name>
